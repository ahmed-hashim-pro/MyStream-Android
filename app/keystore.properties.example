# Release signing credentials for :app — copy to `keystore.properties` (same folder)
# and fill in. That filename is gitignored; this .example file is the only one committed.
#
#   cp app/keystore.properties.example app/keystore.properties
#
# Then build a signed Play Store bundle:
#
#   ./gradlew :app:bundleMadaniRelease
#   # -> app/build/outputs/bundle/madaniRelease/app-madani-release.aab
#
# Verify what came out before uploading:
#
#   jarsigner -verify -verbose:summary app/build/outputs/bundle/madaniRelease/*.aab
#
# NEVER commit the real keystore.properties or the .jks itself. Both are in .gitignore;
# if either ever lands in a commit, treat the key as compromised — for an app already on
# Play that means requesting an upload-key reset, since the key cannot be rotated freely.
#
# CI can supply these as environment variables instead of this file:
#   MYSTREAM_STORE_FILE, MYSTREAM_STORE_PASSWORD, MYSTREAM_KEY_ALIAS, MYSTREAM_KEY_PASSWORD

# Absolute path to the upload keystore.
storeFile=/absolute/path/to/upload-keystore.jks

# Password for the keystore file itself.
storePassword=

# Alias of the key inside that keystore (e.g. `upload`).
keyAlias=

# Password for that key. Often the same as storePassword.
keyPassword=
