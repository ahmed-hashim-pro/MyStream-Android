<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================ -->
    <!-- Base application theme (Material 3)                          -->
    <!-- ============================================================ -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <!-- M3 color attributes -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>

        <!-- Legacy compat -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Shape system -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MyStream.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MyStream.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MyStream.LargeComponent</item>

        <!-- Transitions -->
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@transition/activity_slide</item>
        <item name="android:windowExitTransition">@transition/activity_fade</item>
        <item name="android:windowSharedElementEnterTransition">@transition/change_image_transform</item>
        <item name="android:windowSharedElementExitTransition">@transition/change_image_transform</item>
    </style>

    <!-- ============================================================ -->
    <!-- Theme variant: No action bar (most activities use this)      -->
    <!-- ============================================================ -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Audio download manager: NoActionBar + a navy multi-select contextual bar
         (gold close/menu icons via a dark action-bar overlay). -->
    <style name="AppTheme.AudioManager" parent="AppTheme.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeBackground">@color/navy_700</item>
        <item name="actionModeStyle">@style/Widget.MyStream.AudioActionMode</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MyStream.AudioActionBar</item>
    </style>

    <!-- Navy contextual (multi-select) bar background -->
    <style name="Widget.MyStream.AudioActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/navy_700</item>
    </style>

    <style name="ThemeOverlay.MyStream.AudioActionBar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <!-- Close (✕) and contextual menu icons drawn in gold on the navy bar -->
        <item name="colorControlNormal">@color/gold_accent</item>
    </style>

    <!-- Gold-accented dialog surfaces for the Mushaf (jump / tag / download dialogs).
         Wired via alertDialogTheme + materialAlertDialogTheme on QuranToolBar so bare
         AlertDialog.Builder dialogs pick up gold buttons/inputs/cursors. -->
    <style name="ThemeOverlay.MyStream.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="colorPrimary">@color/gold_accent</item>
        <item name="colorAccent">@color/gold_accent</item>
        <item name="colorControlActivated">@color/gold_accent</item>
    </style>

    <style name="ThemeOverlay.MyStream.MaterialDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/gold_accent</item>
        <item name="colorAccent">@color/gold_accent</item>
        <item name="colorControlActivated">@color/gold_accent</item>
    </style>

    <!-- Navy popup/overflow menu for the Mushaf toolbars (index, reader, audio manager). -->
    <style name="ThemeOverlay.MyStream.PopupMenu" parent="ThemeOverlay.Material3.Dark">
        <item name="colorSurface">@color/navy_700</item>
        <item name="colorOnSurface">@color/text_on_navy</item>
        <item name="android:colorBackground">@color/navy_700</item>
        <item name="colorControlNormal">@color/gold_accent</item>
        <item name="colorControlActivated">@color/gold_accent</item>
        <item name="popupMenuStyle">@style/Widget.MyStream.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.MyStream.PopupMenu.Overflow</item>
    </style>

    <style name="Widget.MyStream.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_navy</item>
    </style>

    <style name="Widget.MyStream.PopupMenu.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_navy</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <!-- Admin variant (no action bar + dark control highlight) -->
    <style name="AppTheme.AdminNoActionBarTheme" parent="AppTheme.NoActionBar">
        <item name="colorControlHighlight">@color/black</item>
        <item name="android:actionMenuTextColor">@color/black</item>
    </style>

    <!-- ============================================================ -->
    <!-- Theme variant: Dark toolbar (MainActivity)                   -->
    <!-- ============================================================ -->
    <style name="AppTheme.MainActivity" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/colorPrimaryMainActivity</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDarkMainActivity</item>
        <item name="colorAccent">@color/colorAccentMainActivity</item>
        <item name="android:statusBarColor">@color/color_status_bar</item>
        <item name="android:navigationBarColor">@color/color_nav_bar</item>
        <item name="android:windowEnterTransition">@transition/activity_fade</item>
        <item name="android:windowExitTransition">@transition/activity_slide</item>
    </style>

    <!-- ============================================================ -->
    <!-- Theme variant: Dark toolbar (detail/video activities)        -->
    <!-- ============================================================ -->
    <style name="AppTheme.DarkToolbar" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/Black2</item>
        <item name="colorPrimaryDark">@color/Black2</item>
    </style>

    <!-- ============================================================ -->
    <!-- Theme variant: Fullscreen                                    -->
    <!-- ============================================================ -->
    <style name="FullscreenTheme" parent="AppTheme">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <!-- ============================================================ -->
    <!-- Theme variant: Translucent (chat login/register)             -->
    <!-- ============================================================ -->
    <style name="Translucent" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="TranslucentBackground" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@drawable/bg</item>
    </style>

    <!-- ============================================================ -->
    <!-- Backward-compat aliases (map old names -> consolidated)      -->
    <!-- ============================================================ -->
    <style name="AppTheme.NoActionBarTheme" parent="AppTheme.NoActionBar" />
    <style name="AppTheme.SignIn" parent="AppTheme.NoActionBar">
        <item name="android:statusBarColor">@color/color_status_bar</item>
        <item name="android:navigationBarColor">@color/color_nav_bar</item>
    </style>
    <style name="AppTheme.AyaList" parent="AppTheme.NoActionBar" />
    <style name="AppTheme.UserInformation" parent="AppTheme" />
    <style name="AppTheme.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/mystream_round</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/background_splash</item>
        <item name="android:navigationBarColor">@color/background_splash</item>
    </style>
    <style name="AppTheme.Settings" parent="AppTheme.NoActionBar">
        <item name="android:statusBarColor">@color/background_main</item>
        <item name="android:navigationBarColor">@color/background_main</item>
        <item name="android:windowEnterTransition">@transition/activity_slide</item>
        <item name="android:windowExitTransition">@transition/activity_fade</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.MyStream</item>
    </style>

    <!-- ============================================================ -->
    <!-- Settings / Preference styles                                 -->
    <!-- ============================================================ -->
    <style name="SettingsToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PreferenceThemeOverlay.MyStream" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/Preference.Category.MyStream</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.Switch.MyStream</item>
        <item name="preferenceStyle">@style/Preference.MyStream</item>
    </style>

    <style name="Preference.Category.MyStream" parent="Preference.Category">
        <item name="android:textColor">@color/gold_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="allowDividerAbove">true</item>
    </style>

    <style name="Preference.Switch.MyStream" parent="Preference.SwitchPreferenceCompat">
        <item name="android:widgetLayout">@layout/preference_switch_widget</item>
    </style>

    <style name="Preference.MyStream" parent="Preference">
    </style>
    <style name="AppTheme.QuranMediaPlayer" parent="AppTheme.NoActionBar">
        <item name="android:statusBarColor">@color/color_status_bar</item>
        <item name="android:navigationBarColor">@color/color_nav_bar</item>
    </style>
    <style name="AppTheme.YoutubePlayerViewActivity" parent="AppTheme.DarkToolbar" />
    <style name="AppTheme.DetailActivity" parent="AppTheme.DarkToolbar">
        <item name="colorAccent">@color/white</item>
    </style>
    <style name="AppTheme.NoActionBar2" parent="AppTheme.NoActionBar">
        <item name="colorAccent">@color/Black2</item>
    </style>
    <style name="AppTheme.NoActionBar3" parent="AppTheme.NoActionBar">
        <item name="android:background">@color/darkblue</item>
    </style>
    <style name="AppTheme.RewardVideo" parent="AppTheme.NoActionBar">
        <item name="android:background">@color/rewardVideoBackground</item>
    </style>
    <style name="AppTheme.DarkBlue" parent="AppTheme">
        <item name="android:background">@color/blue</item>
    </style>
    <style name="AppTheme.subsetting" parent="AppTheme.NoActionBar">
        <item name="colorPrimaryDark">@color/color_status_bar</item>
    </style>
    <style name="MyThemeNoActionbar" parent="AppTheme.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- ============================================================ -->
    <!-- Spotify-inspired text styles                                 -->
    <!-- ============================================================ -->
    <style name="SpotifyHeadline">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SpotifySubhead">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ============================================================ -->
    <!-- Shape Appearances (M3 shape system)                          -->
    <!-- ============================================================ -->
    <style name="ShapeAppearance.MyStream.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.MyStream.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.MyStream.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ============================================================ -->
    <!-- Dialog styles                                                -->
    <!-- ============================================================ -->
    <style name="ThemeOverlay.MyDialogActivity" parent="ThemeOverlay.Material3.Dialog">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/dialog_rounded_corner</item>
        <item name="colorPrimary">@color/black</item>
    </style>

    <style name="BottomSheetDialog" parent="AppTheme.MainActivity">
        <item name="background">@color/black</item>
    </style>

    <style name="AppBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppBottomSheet</item>
    </style>

    <style name="AppBottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.MyStream.BottomSheet</item>
        <item name="backgroundTint">@color/background_surface</item>
    </style>

    <style name="ShapeAppearance.MyStream.BottomSheet" parent="">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>

    <!-- ============================================================ -->
    <!-- Button styles                                                -->
    <!-- ============================================================ -->
    <style name="ThemeOverlay.MyBlueButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cyan_500</item>
    </style>

    <style name="ThemeOverlay.MyDarkButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/background_input_button</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.GoldButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/gold_accent</item>
        <item name="android:textColor">@color/text_on_gold</item>
    </style>

    <!-- ============================================================ -->
    <!-- Firebase / theme overlays                                    -->
    <!-- ============================================================ -->
    <style name="ThemeOverlay.FirebaseIcon" parent="AppTheme">
        <item name="android:layout_marginTop">@dimen/icon_top_margin</item>
        <item name="android:layout_marginBottom">@dimen/icon_bottom_margin</item>
    </style>

    <style name="ThemeOverlay.MyTextDetail" parent="AppTheme">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fadeScrollbars">true</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">5</item>
        <item name="android:padding">4dp</item>
        <item name="android:scrollbars">vertical</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ThemeOverlay.MyTitleText" parent="AppTheme">
        <item name="android:gravity">center</item>
        <item name="android:textSize">36sp</item>
    </style>

    <!-- ============================================================ -->
    <!-- Text styles                                                  -->
    <!-- ============================================================ -->
    <style name="TitleText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/title_color</item>
        <item name="android:lines">1</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TranslationText">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TranslationText.Highlighted">
        <item name="android:textColor">@color/translation_highlight</item>
    </style>

    <style name="TranslationText.NightMode">
        <item name="android:background">@android:color/black</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TranslationText.NightMode.Highlighted">
        <item name="android:textColor">@color/translation_highlight</item>
    </style>

    <style name="PageTypeTitle">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PageTypeDescription">
        <item name="android:textColor">#AAAAAA</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SearchResult">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SearchResult.Location">
        <item name="android:textColor">#AAAAAA</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PanelLabel">
        <item name="android:textColor">@color/panel_label</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ============================================================ -->
    <!-- Spinner styles (Quran reader)                                -->
    <!-- ============================================================ -->
    <style name="SherlockDropDownItem">
        <item name="android:textAppearance">@style/SherlockDropDownItemText</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SherlockDropDownItemText">
        <item name="android:textColor">@color/sherlock_primary_text_disable</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="SherlockSpinnerItem">
        <item name="android:textAppearance">@style/SherlockSpinnerItemText</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="SherlockSpinnerItemText">
        <item name="android:textColor">@color/sherlock_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- ============================================================ -->
    <!-- Bottom Navigation active indicator                           -->
    <!-- ============================================================ -->
    <style name="Widget.MyStream.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_indicator</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MyStream.PillIndicator</item>
    </style>

    <style name="TextAppearance.MyStream.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MyStream.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- ============================================================ -->
    <!-- Miscellaneous                                                -->
    <!-- ============================================================ -->
    <style name="ToolBarArea" />

    <style name="NotificationText"
        parent="android:TextAppearance.StatusBar.EventContent" />

    <style name="NotificationTitle"
        parent="android:TextAppearance.StatusBar.EventContent.Title" />

    <style name="EditTextTintTheme" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimaryDark">#0288D1</item>
    </style>

    <style name="TextLabel" parent="AppTheme.NoActionBar">
        <item name="colorControlActivated">@color/gold_accent</item>
    </style>

    <style name="AppTheme.AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">@string/ad_attribution</item>
        <item name="android:background">#D4A44C</item>
        <item name="android:width">15dp</item>
        <item name="android:height">15dp</item>
    </style>

    <string name="ad_attribution">Ad</string>

    <style name="ToastText">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="OnbSectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onb_text_secondary</item>
    </style>

</resources>
