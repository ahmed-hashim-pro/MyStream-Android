<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Widget.MyStream style for namespace -->
    <style name="Widget.MyStream" parent=""></style>

    <!-- Classic dense list row: number/icon badge + 2-line title + trailing action -->
    <style name="Widget.MyStream.ListRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.MyStream.ListRow.Badge">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <!-- reset the 16dp horizontal padding inherited (via dot-notation) from
             the parent ListRow style; paddingStart/End take precedence over
             android:padding, and 32dp > the 30dp badge width collapses the
             number's text layout to zero width (digit never drawn). -->
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/gold_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_listrow_badge</item>
    </style>

    <style name="Widget.MyStream.ListRow.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.MyStream.ListRow.Meta">
        <item name="android:textColor">@color/sura_details_color</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Section header: "Title ... action" (A .bn-sec rhythm: 20/11 with a 2dp inset;
         rtl so the title sits far right and the action far left, like A space-between). -->
    <style name="Widget.MyStream.SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <style name="Widget.MyStream.SectionHeader.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Quick-action tile: rounded elevated warm-surface card with gold-faint ripple -->
    <style name="Widget.MyStream.QuickAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:background">@drawable/bg_qa_tile</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Standard content card: white panel on the cream page, warm hairline, 18dp (A .bn-card) -->
    <style name="Widget.MyStream.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">15dp</item>
        <item name="cardBackgroundColor">@color/background_card</item>
        <item name="strokeColor">@color/divider_warm_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Navy feature card (continue reading): gradient applied on the inner content
         (cardBackgroundColor cannot be a gradient), so the card itself is transparent
         with no padding/stroke and the LinearLayout carries bg_card_continue. -->
    <style name="Widget.MyStream.Card.Feature" parent="Widget.MyStream.Card">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="contentPadding">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- BottomNav intermediate style (required for Widget.MyStream.BottomNav.ActiveIndicator) -->
    <style name="Widget.MyStream.BottomNav"></style>

    <!-- ============================================================ -->
    <!-- Home Redesign v2: Glass / Arc / Timeline / Dock styles       -->
    <!-- ============================================================ -->

    <!-- Glass card: translucent white over navy, 18dp corners -->
    <style name="Widget.MyStream.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="contentPadding">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Circular progress arc: gold track for streak/goal widget -->
    <style name="Widget.MyStream.StatArc" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:indeterminate">false</item>
        <item name="android:progressDrawable">@drawable/bg_stat_arc_track</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <!-- Prayer timeline node label: small centered text -->
    <style name="Widget.MyStream.PrayerNode">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Radio / Now-Playing card: navy background, 18dp corners -->
    <style name="Widget.MyStream.RadioNowPlaying" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/navy_700</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="contentPadding">14dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Discover card: warm surface, 16dp corners, light elevation.
         Uses ?attr/colorSurface so it adapts correctly in dark mode. -->
    <style name="Widget.MyStream.Discover" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPadding">12dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Compact tab-header bar: navy background, actionBarSize height, shared by G2–G4 fragments -->
    <style name="Widget.MyStream.TabHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:background">@color/navy_700</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.MyStream.TabHeader.Title">
        <item name="android:textColor">@color/gold_accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- NOTE: Widget.MyStream.BottomNav.ActiveIndicator is defined in styles.xml —
         extended there; PillDock references it via the existing name. -->

    <!-- Pill-dock BottomNavigationView: warm surface + gold selected items -->
    <style name="Widget.MyStream.BottomNav.PillDock" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_pill_dock</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.MyStream.BottomNav.ActiveIndicator</item>
        <item name="labelVisibilityMode">selected</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
    </style>

    <!-- Lozenge/pill shape for the active indicator -->
    <style name="ShapeAppearance.MyStream.PillIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
