<resources>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="Quran" parent="Theme.Material3.DayNight">
        <item name="colorAccent">@color/gold_accent</item>
        <item name="spinnerStyle">?attr/actionDropDownStyle</item>
        <item name="spinnerDropDownItemStyle">@style/SherlockDropDownItem</item>
        <item name="spinnerItemStyle">@style/SherlockSpinnerItem</item>
        <!-- Cairo UI font across the Mushaf (matches the re-theme mockups). -->
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

    <style name="QuranToolBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorAccent">@color/gold_accent</item>
        <item name="colorControlActivated">@color/gold_accent</item>
        <!-- Cairo UI font across the Mushaf (matches the re-theme mockups). -->
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="spinnerStyle">?attr/actionDropDownStyle</item>
        <item name="spinnerDropDownItemStyle">@style/SherlockDropDownItem</item>
        <item name="spinnerItemStyle">@style/SherlockSpinnerItem</item>
        <item name="android:statusBarColor">@color/navy_900</item>
        <item name="android:navigationBarColor">@color/navy_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Gold-accented dialogs + navy multi-select contextual bar across Mushaf screens -->
        <item name="alertDialogTheme">@style/ThemeOverlay.MyStream.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MyStream.MaterialDialog</item>
        <item name="actionModeBackground">@color/navy_700</item>
        <item name="actionModeStyle">@style/Widget.MyStream.AudioActionMode</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MyStream.AudioActionBar</item>
    </style>

    <style name="QuranToolBar.Overlay">
        <item name="windowActionBarOverlay">true</item>
    </style>

    <!-- About screen: gold preference-category headers (was teal colorAccent). -->
    <style name="QuranToolBar.About">
        <item name="colorAccent">@color/gold_accent</item>
        <!-- Style the About preference list like Settings (gold category headers). -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.MyStream</item>
    </style>

    <!-- Host theme for the quick-jump widget shortcut (ShowJumpFragmentActivity).
         Gold accents so the jump dialog matches the in-app navy+gold language. -->
    <style name="QuranDialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="colorPrimary">@color/gold_accent</item>
        <item name="colorAccent">@color/gold_accent</item>
        <item name="colorControlActivated">@color/gold_accent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MyStream.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MyStream.MaterialDialog</item>
    </style>

    <!-- Full-screen athan alarm screen (shows over lock screen / other apps). -->
    <style name="AthanAlarmTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_main</item>
        <item name="android:statusBarColor">@color/background_main</item>
        <item name="android:navigationBarColor">@color/background_main</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
