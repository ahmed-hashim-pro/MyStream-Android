<?xml version="1.0" encoding="utf-8"?>
<!-- Tag checkboxes on the navy ayah panel: gold fill when checked, half-white
     outline otherwise (mockup .cbx / .cbx.on). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/gold_accent" />
    <item android:color="#80FFFFFF" />
</selector>
