<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    tools:context=".hashimyoutubeplayer.YoutubePlayerViewActivity">

    <com.google.android.youtube.player.YouTubePlayerView
        android:id="@+id/youtube_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/titleCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:cardElevation="20dp"
        android:layoutDirection="rtl"
        app:cardMaxElevation="20dp"
        app:cardPreventCornerOverlap="true"
        android:focusableInTouchMode="true"
        android:layout_gravity="bottom"

        app:contentPadding="2dp">
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal">



            <ImageButton
                android:id="@+id/seemore"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:background="@null"
                app:tint="@color/black"
                android:src="@drawable/outline_expand_more_24" />


            <TextView
                android:id="@+id/textView13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:textStyle="bold"
                android:layout_marginTop="30px"
                android:layout_marginBottom="30px"
                android:text="Loading..." />



            <!--<RelativeLayout
                android:id="@+id/Viewlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="5dp"
                android:paddingEnd="@dimen/activity_horizontal_margin">


                <ImageView
                    android:id="@+id/eye"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:src="@drawable/views" />

                <TextView
                    android:id="@+id/ViewsNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_toEndOf="@+id/eye"
                    android:text="0"
                    android:textColor="@color/black" />
            </RelativeLayout>-->
        </LinearLayout>


    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/titledesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:cardBackgroundColor="@color/white"
        app:cardElevation="20dp"
        android:layoutDirection="rtl"
        app:cardMaxElevation="12dp"
        app:cardPreventCornerOverlap="true"
        android:focusableInTouchMode="true"
        android:layout_gravity="bottom"

        app:contentPadding="2dp">

        <RelativeLayout
            android:id="@+id/descriptionContainer"
            android:layout_width="match_parent"
            android:layout_height="0px">

            <ScrollView
                android:id="@+id/descscroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6px"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="9dp"
                        android:paddingTop="4px"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4px"
                        android:text="" />
                </LinearLayout>

            </ScrollView>


        </RelativeLayout>


    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/starCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="20dp"
        android:layoutDirection="rtl"
        app:cardMaxElevation="20dp"
        app:cardPreventCornerOverlap="true"
        android:focusableInTouchMode="true"
        android:layout_gravity="bottom"
        >
        <LinearLayout
            android:id="@+id/interact"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layoutDirection="ltr"
            android:layout_below="@+id/divider">
            <RelativeLayout
                android:id="@+id/star_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_weight="4"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:background="@drawable/btn_like"
                android:elevation="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/star"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@+id/post_num_stars"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_toggle_star_outline_24" />

                <TextView
                    android:id="@+id/post_num_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="3dp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    tools:text="75" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/share_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_weight="4"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:background="@drawable/btn_like"
                android:elevation="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/buttonShare"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/outline_share_24" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.7"
                android:gravity="end"
                android:layout_gravity="center"
                android:visibility="invisible"
                android:orientation="horizontal"


                >

                <TextView
                    android:id="@+id/ViewsNum"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:text="11"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@+id/ViewsNum"
                    android:src="@drawable/outline_visibility_24" />
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/option_layout2"
                android:layout_width="45dp"
                android:layout_weight="0.1"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/videoOption"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="10dp"
                    android:paddingEnd="5dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/baseline_more_vert_24" />



            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/autherCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="20dp"
        android:layoutDirection="rtl"
        app:cardMaxElevation="20dp"
        app:cardPreventCornerOverlap="true"
        android:focusableInTouchMode="true"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:contentPadding="2dp">
        <include
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_width="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:id="@+id/post_author_layout"
            layout="@layout/include_youtube_full_post_author"
            android:layout_height="wrap_content" />
    </androidx.cardview.widget.CardView>

    <!--<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/youtube_layout" />
    </LinearLayout>-->


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/titledesc"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_above="@+id/comment_form">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                >

                <ImageView
                    android:id="@+id/FullThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/mystream" />

                <!--<LinearLayout
                    android:id="@+id/playerHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:orientation="horizontal"

                    >


                </LinearLayout>-->
                <!--<RelativeLayout
                    android:id="@+id/sVideo"
                    android:layout_width="match_parent"
                    android:layout_below="@+id/playerHeight"
                    android:layout_height="wrap_content">

                </RelativeLayout>-->

                <LinearLayout
                    android:id="@+id/ad_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical"
                    android:gravity="center"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:text="@string/Press_Add"
                        />

                    <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/adView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        ads:adSize="BANNER"
                        ads:adUnitId="@string/banner_ad_unit_id">

                    </com.google.android.gms.ads.AdView>
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/all"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/ad_layout"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="#cc040303">



                    <RelativeLayout
                        android:id="@+id/postAuther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:paddingEnd="@dimen/activity_horizontal_margin">


                        <!--<include
                            android:id="@+id/post_author_layout"
                            layout="@layout/include_post_author" />-->
                        <Button
                            android:id="@+id/showVideo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:onClick="ShowVideo"
                            android:text="@string/showVideo"
                            android:visibility="gone" />
                    </RelativeLayout>


                    <LinearLayout
                        android:id="@+id/postText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/postAuther"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="16dp">

                        <include
                            android:id="@+id/post_text_layout"
                            layout="@layout/include_post_text"
                            android:visibility="gone"

                            />
                    </LinearLayout>


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_comments"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/postText"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:paddingStart="@dimen/activity_horizontal_margin"
                        android:paddingEnd="@dimen/activity_horizontal_margin"
                        tools:listitem="@layout/item_comment" />
                </RelativeLayout>




            </RelativeLayout>

        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/comment_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            app:cardElevation="20dp"
            app:cardMaxElevation="20dp"
            android:layoutDirection="ltr"
            app:cardPreventCornerOverlap="true"
            android:focusableInTouchMode="true"
            android:layout_marginTop="5dp"
            android:layout_alignParentBottom="true"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                >

                <EditText
                    android:id="@+id/field_comment_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:hint="@string/WriteComment"
                    android:imeOptions="actionSend|flagNoEnterAction"
                    android:maxLines="1"
                    android:textColorHint="@color/textHint" />

                <Button
                    android:id="@+id/button_post_comment"
                    style="@style/Base.Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.2"
                    android:text="@string/post"

                    android:textColor="@color/black" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </RelativeLayout>


</LinearLayout>