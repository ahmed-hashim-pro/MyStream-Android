<?xml version="1.0" encoding="utf-8"?>
<!-- Settings section header (mockup .sec, gold variant used on pages 12/13):
     small gold uppercase label + trailing hairline filling the row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.07"
        android:textAllCaps="true"
        android:textColor="@color/gold_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@color/row_divider_hairline" />
</LinearLayout>
