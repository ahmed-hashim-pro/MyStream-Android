<?xml version="1.0" encoding="utf-8"?>
<!-- "Start playback from:" prompt (mockup playback-sheet-redesign): fixed navy
     chrome like the rest of the audio system, gold play badge + reciter
     subline in the header, option rows filled by AppBottomSheet, ghost
     cancel. Content sits on the shared 16dp inset. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_navy"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <View
        android:layout_width="42dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_grab" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_play_fab"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_play"
            app:tint="@color/text_on_gold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ps_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playback_prompt_title"
                android:textColor="@color/text_on_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ps_reciter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/hint_on_navy"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ps_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ps_cancel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/cancel"
        android:textColor="@color/gold_light"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:rippleColor="@color/gold_accent_faint"
        app:strokeColor="@color/gold_accent_semi"
        app:strokeWidth="1.5dp" />
</LinearLayout>
