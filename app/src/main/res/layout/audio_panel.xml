<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    >
  <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingBottom="16dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/play_from"
        android:textAppearance="@style/PanelLabel"
        />
    <!-- sura (2) + ayah (1) selectors in gold-bordered boxes (mockup 06). The border
         and the end-caret live on wrapper frames: the spinner's own background is
         nulled (kills the platform caret) and QuranSpinner's width hack can't fight
         the box that way. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        >
      <FrameLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="2"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bg_panel_spinner_box">
        <com.medoapps.www.onlinequran.view.QuranSpinner
            android:id="@+id/start_sura_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_caret_down_gold"
            android:importantForAccessibility="no"
            />
      </FrameLayout>
      <FrameLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="@drawable/bg_panel_spinner_box">
        <com.medoapps.www.onlinequran.view.QuranSpinner
            android:id="@+id/start_ayah_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_caret_down_gold"
            android:importantForAccessibility="no"
            />
      </FrameLayout>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/play_to"
        android:textAppearance="@style/PanelLabel"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        >
      <FrameLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="2"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bg_panel_spinner_box">
        <com.medoapps.www.onlinequran.view.QuranSpinner
            android:id="@+id/end_sura_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_caret_down_gold"
            android:importantForAccessibility="no"
            />
      </FrameLayout>
      <FrameLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="@drawable/bg_panel_spinner_box">
        <com.medoapps.www.onlinequran.view.QuranSpinner
            android:id="@+id/end_ayah_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_caret_down_gold"
            android:importantForAccessibility="no"
            />
      </FrameLayout>
    </LinearLayout>

    <include layout="@layout/play_set_of_verses" />
    <include layout="@layout/play_each_verse" />

    <CheckBox
        android:id="@+id/restrict_to_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:buttonTint="@color/checkbox_on_navy_tint"
        android:textColor="@color/text_on_navy"
        android:textSize="13sp"
        android:text="@string/play_restrict_range"
        />

    <Button
        android:id="@+id/apply"
        style="@style/ThemeOverlay.GoldButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/play_apply"
        android:layout_gravity="end"
        />
  </LinearLayout>
</ScrollView>
