<?xml version="1.0" encoding="utf-8"?>
<!--
  Glossier reciter card (§4.8):
  - MaterialCardView gives rounded corners + subtle elevation + ripple
  - Rounded thumbnail fills the top of the card
  - Gold play badge overlays the bottom-end of the thumbnail
  - Reciter name sits below
  HomeReciterAdapter binds: R.id.reciter_image (ImageView), R.id.reciter_name (TextView)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:rippleColor="@color/gold_accent_faint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thumbnail container: fixed aspect, rounded top (card clips for us) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <ImageView
                android:id="@+id/reciter_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- Gold play badge: small circle at bottom-end of the thumbnail -->
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                app:srcCompat="@drawable/baseline_play_circle_24"
                app:tint="@color/gold_accent"
                android:contentDescription="@null"
                android:alpha="0.92" />

        </FrameLayout>

        <!-- Reciter name beneath the thumbnail -->
        <TextView
            android:id="@+id/reciter_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
