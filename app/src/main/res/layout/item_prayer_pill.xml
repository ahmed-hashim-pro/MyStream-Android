<?xml version="1.0" encoding="utf-8"?>
<!-- Single prayer pill card for the A pill-rail: name + time.
     Background swapped in code: bg_prayer_pill (default) / bg_prayer_pill_now (next). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="62dp"
    android:background="@drawable/bg_prayer_pill"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/pill_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/sura_details_color"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:ignore="UnusedAttribute"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/pill_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/navy_700"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
