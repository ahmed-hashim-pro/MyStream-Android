<?xml version="1.0" encoding="utf-8"?>
<!-- One search result, styled as a navy-theme card: location (gold) + verse snippet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_search_result_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/verseLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gold_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/verseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="?android:textColorPrimary"
        android:textSize="15sp" />
</LinearLayout>
