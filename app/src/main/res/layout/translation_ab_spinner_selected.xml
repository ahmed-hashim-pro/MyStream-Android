<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="wrap_content"
              android:layout_height="?attr/actionBarSize"
              android:gravity="center_vertical"
              android:paddingStart="4dp"
              android:paddingEnd="4dp"
              android:layout_gravity="center_vertical|start"
    >
  <!-- Title/subtitle live on the always-navy reader toolbar; without an explicit
       on-navy color they inherit the theme's dark text. Reuse the reader text
       appearances (white title / muted subtitle, Amiri + Cairo). -->
  <TextView
      android:id="@+id/title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:maxLines="1"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:textAppearance="@style/TextAppearance.MyStream.ReaderTitle"
      />
  <TextView
      android:id="@+id/subtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:maxLines="1"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:textAppearance="@style/TextAppearance.MyStream.ReaderSubtitle"
      />
</LinearLayout>
