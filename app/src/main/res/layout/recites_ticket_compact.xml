<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@color/transparent"
    android:paddingBottom="1dp"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="1dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/ripple_card_compact"
        app:cardElevation="0dp"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/background_card"
        app:cardPreventCornerOverlap="true"
        app:contentPadding="8dp">

        <LinearLayout
            android:id="@+id/entireCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgchannel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ramadan_quran"
                app:tint="@color/gold_accent" />

            <TextView
                android:id="@+id/txtRecitesName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:transitionName="shared_reciter"
                android:paddingEnd="4dp"
                android:paddingStart="4dp"
                android:text="Large Text"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/buttonShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/btn_share"
                app:tint="@color/icon_secondary" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardviewad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layoutDirection="rtl"
        android:visibility="gone"
        app:cardBackgroundColor="@color/background_card"
        app:cardElevation="@dimen/card_elevation_default"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardCornerRadius="8dp"
        app:cardPreventCornerOverlap="true">

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/youtubeCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:foreground="@drawable/ripple_card"
        app:cardElevation="@dimen/card_elevation_default"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardBackgroundColor="@color/background_card"
        app:cardCornerRadius="12dp"
        android:layoutDirection="ltr"
        app:cardPreventCornerOverlap="true"
        android:visibility="gone"
        android:focusableInTouchMode="true">
        <RelativeLayout
            android:id="@+id/EntireLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </androidx.cardview.widget.CardView>

</RelativeLayout>
