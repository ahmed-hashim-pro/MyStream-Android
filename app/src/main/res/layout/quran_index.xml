<?xml version="1.0" encoding="utf-8"?>
<!--
  Mushaf index with a collapsing navy hero card (matches the proposed design).
  The header is one rounded navy card: [title + icons] -> search bar -> tabs.
  Expanded shows all three; on scroll the search field AND the tabs collapse with
  the hero, leaving the rounded title+icons bar. Title/collapse-fade wired by
  HeroController; the pinned toolbar hosts the title + the options menu.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/heroCollapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_navy_rounded"
            android:elevation="4dp"
            app:contentScrim="@drawable/bg_header_navy_rounded"
            app:layout_scrollFlags="scroll|enterAlways|exitUntilCollapsed|snap"
            app:titleEnabled="false">

            <!-- Collapsing area (parallax): search field + tabs. Both scroll away
                 with the hero on collapse, leaving the pinned title + icons bar. -->
            <LinearLayout
                android:id="@+id/heroExpanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/actionBarSize"
                android:orientation="vertical"
                android:paddingBottom="6dp"
                android:layoutDirection="locale"
                app:layout_collapseMode="parallax">

                <!-- Real, functional search field (no separate toolbar icon) -->
                <SearchView
                    android:id="@+id/index_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_index_search"
                    android:iconifiedByDefault="false"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:queryBackground="@android:color/transparent"
                    android:submitBackground="@android:color/transparent" />

                <!-- Tabs are part of the hero card and collapse with it -->
                <com.medoapps.www.onlinequran.view.SlidingTabLayout
                    android:id="@+id/indicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ToolBarArea" />
            </LinearLayout>

            <!-- Pinned toolbar: title + subtitle on the start, options menu on the end -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layoutDirection="locale"
                android:theme="@style/ThemeOverlay.MyStream.AudioActionBar"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.MyStream.PopupMenu">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/cairo_extrabold"
                        android:singleLine="true"
                        android:textColor="@color/text_on_navy"
                        android:textSize="19sp"
                        tools:text="Mushaf" />

                    <TextView
                        android:id="@+id/heroSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/hint_on_navy"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="The Holy Quran" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrolling content: continue card (pinned above) + the tab pager -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/continue_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/background_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/divider_warm"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:text="🕌"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/continue_reading"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/continue_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="Al-Baqarah · Page 49" />
                </LinearLayout>

                <TextView
                    android:id="@+id/continue_read_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_continue_read_cta"
                    android:drawablePadding="6dp"
                    android:elevation="4dp"
                    android:gravity="center_vertical"
                    android:outlineAmbientShadowColor="@color/gold_accent"
                    android:outlineSpotShadowColor="@color/gold_accent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/continue_read_action"
                    android:textColor="@color/navy_900"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_play_triangle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.medoapps.www.onlinequran.view.QuranViewPager
                android:id="@+id/index_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Inline live search results — cover the pager/tabs while a query is active -->
            <LinearLayout
                android:id="@+id/index_search_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_main"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/index_search_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/navy_700"
                    android:padding="13dp"
                    android:textColor="@color/text_on_navy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ListView
                    android:id="@+id/index_search_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp"
                    android:scrollbars="none" />

                <LinearLayout
                    android:id="@+id/index_search_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="30dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_icon_frame_gold"
                        android:contentDescription="@null"
                        android:padding="22dp"
                        android:src="@drawable/ic_search_lens" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/search_no_results_title"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/index_search_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:maxWidth="260dp"
                        android:text="@string/search_no_results_hint"
                        android:textColor="@color/sura_details_color"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
