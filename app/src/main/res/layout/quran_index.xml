<?xml version="1.0" encoding="utf-8"?>
<!--
  Mushaf index with a collapsing navy hero (matches the proposed design).
  Expanded: big "Mushaf" title + subtitle + search field. Collapses on scroll to a
  compact navy toolbar (gold title) with the tabs pinned below it.
  Title/subtitle/collapse-fade are wired by HeroController (ids: appbar, heroExpanded,
  heroTitle, heroSubtitle, heroCollapsedTitle); the pinned toolbar hosts the options menu.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/heroCollapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_navy"
            android:elevation="4dp"
            app:contentScrim="@drawable/bg_header_navy"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false">

            <!-- Collapsing area (parallax): just the search field. The title now
                 lives in the pinned toolbar (next to the action icons), so only
                 the search bar scrolls away on collapse. -->
            <LinearLayout
                android:id="@+id/heroExpanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/actionBarSize"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:layoutDirection="locale"
                app:layout_collapseMode="parallax">

                <!-- Search field (launches the Quran search) -->
                <LinearLayout
                    android:id="@+id/index_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_index_search"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="13dp"
                    android:paddingVertical="11dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="9dp"
                        android:src="@drawable/ic_ab_search"
                        android:contentDescription="@string/search_hint"
                        app:tint="@color/gold_accent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/search_hint"
                        android:textColor="@color/hint_on_navy"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pinned toolbar: title + subtitle on the start, options menu on the end -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layoutDirection="locale"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text_on_navy"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="Mushaf" />

                    <TextView
                        android:id="@+id/heroSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/hint_on_navy"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="The Holy Quran" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Tabs pinned below the collapsing hero -->
        <com.medoapps.www.onlinequran.view.SlidingTabLayout
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy_700"
            android:elevation="4dp"
            style="@style/ToolBarArea" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrolling content: continue card (pinned above) + the tab pager -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.cardview.widget.CardView
            android:id="@+id/continue_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/background_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_icon_frame_gold"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_mushaf"
                    android:contentDescription="@string/continue_reading"
                    app:tint="@color/gold_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/continue_reading"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/continue_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/sura_details_color"
                        android:textSize="12sp"
                        tools:text="Al-Baqarah · Page 49" />
                </LinearLayout>

                <TextView
                    android:id="@+id/continue_read_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reading_chip_on"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/continue_read_action"
                    android:textColor="@color/navy_900"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.medoapps.www.onlinequran.view.QuranViewPager
            android:id="@+id/index_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
