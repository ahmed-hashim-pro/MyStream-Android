<?xml version="1.0" encoding="utf-8"?>
<!-- One start-option row: gold-faint icon chip + label + sublabel
     (page number / "from the start of the surah"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ps_row_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_audiobar_avatar"
        android:importantForAccessibility="no"
        android:padding="9dp"
        app:tint="@color/gold_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ps_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_on_navy"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ps_row_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/hint_on_navy"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
