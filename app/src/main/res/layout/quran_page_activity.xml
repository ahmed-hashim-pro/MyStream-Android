<?xml version="1.0" encoding="utf-8"?>
<com.medoapps.www.onlinequran.view.FitSystemRelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    >

  <androidx.viewpager.widget.NonRestoringViewPager
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:id="@+id/quran_pager"
      />

  <!-- Sepia reading tint: warm overlay above the page, below the chrome.
       Not clickable, so page swipes pass through. Toggled by reading-mode. -->
  <View
      android:id="@+id/reading_sepia_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/page_sepia_overlay"
      android:clickable="false"
      android:focusable="false"
      android:visibility="gone" />

  <com.quran.page.common.toolbar.AyahToolBar
      android:id="@+id/ayah_toolbar"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/toolbar_total_height"
      android:visibility="gone"
      />

  <FrameLayout
      android:id="@+id/toolbar_area"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/navy_900"
      >
    <View
        android:id="@+id/status_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:theme="@style/ThemeOverlay.MyStream.GoldActionBar"
        app:popupTheme="@style/ThemeOverlay.MyStream.PopupMenu"
        app:titleTextAppearance="@style/TextAppearance.MyStream.ReaderTitle"
        app:subtitleTextAppearance="@style/TextAppearance.MyStream.ReaderSubtitle"
        >
      <com.medoapps.www.onlinequran.view.QuranSpinner
          android:id="@+id/spinner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:visibility="gone"
          android:popupBackground="@drawable/bg_dropdown_navy"
          />
    </androidx.appcompat.widget.Toolbar>
  </FrameLayout>

  <!-- Text-mode strip: font size (A− / A+) + translation-source chip (mockup 04b).
       Extends the navy chrome under the toolbar; shown only in translation mode. -->
  <LinearLayout
      android:id="@+id/translation_source_strip"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/toolbar_area"
      android:background="@color/navy_900"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="locale"
      android:paddingHorizontal="12dp"
      android:paddingVertical="8dp"
      android:elevation="4dp"
      android:visibility="gone">

    <LinearLayout
        android:id="@+id/translation_source_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_translation_source_chip"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:clickable="true"
        android:focusable="true">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="📚"
          android:textSize="13sp" />

      <TextView
          android:id="@+id/translation_source_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="7dp"
          android:maxWidth="180dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="@color/gold_accent"
          android:textSize="12sp"
          android:fontFamily="@font/cairo_bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:text="▾"
          android:textColor="@color/gold_accent"
          android:textSize="11sp" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/translation_font_decrease"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="A−"
        android:textColor="@color/hint_on_navy"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/translation_font_increase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="A+"
        android:textColor="@color/gold_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />
  </LinearLayout>

  <com.medoapps.www.onlinequran.view.AudioStatusBar
      android:id="@+id/audio_area"
      android:layout_width="match_parent"
      android:layout_height="@dimen/audiobar_height"
      android:layout_alignParentBottom="true"
      android:visibility="gone"
      android:itemBackground="?attr/selectableItemBackgroundBorderless"
      android:background="@color/navy_900"
      />

  <!-- Floating Day / Sepia / Night reading-mode switcher -->
  <LinearLayout
      android:id="@+id/reading_mode_bar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_above="@id/audio_area"
      android:layout_centerHorizontal="true"
      android:layout_marginBottom="16dp"
      android:background="@drawable/bg_reading_mode_bar"
      android:orientation="horizontal"
      android:padding="5dp"
      android:elevation="6dp">

    <TextView
        android:id="@+id/reading_mode_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:text="@string/reading_mode_day" />

    <TextView
        android:id="@+id/reading_mode_sepia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:text="@string/reading_mode_sepia" />

    <TextView
        android:id="@+id/reading_mode_night"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:text="@string/reading_mode_night" />
  </LinearLayout>
</com.medoapps.www.onlinequran.view.FitSystemRelativeLayout>
