<?xml version="1.0" encoding="utf-8"?>
<com.medoapps.www.onlinequran.view.FitSystemRelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    >

  <androidx.viewpager.widget.NonRestoringViewPager
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:id="@+id/quran_pager"
      />

  <!-- Sepia reading tint: warm overlay above the page, below the chrome.
       Not clickable, so page swipes pass through. Toggled by reading-mode. -->
  <View
      android:id="@+id/reading_sepia_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/page_sepia_overlay"
      android:clickable="false"
      android:focusable="false"
      android:visibility="gone" />

  <com.quran.page.common.toolbar.AyahToolBar
      android:id="@+id/ayah_toolbar"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/toolbar_total_height"
      android:visibility="gone"
      />

  <FrameLayout
      android:id="@+id/toolbar_area"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/navy_900"
      >
    <View
        android:id="@+id/status_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.MyStream.PopupMenu"
        >
      <com.medoapps.www.onlinequran.view.QuranSpinner
          android:id="@+id/spinner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:visibility="gone"
          />
    </androidx.appcompat.widget.Toolbar>
  </FrameLayout>

  <com.medoapps.www.onlinequran.view.AudioStatusBar
      android:id="@+id/audio_area"
      android:layout_width="match_parent"
      android:layout_height="@dimen/audiobar_height"
      android:layout_alignParentBottom="true"
      android:visibility="gone"
      android:itemBackground="?attr/selectableItemBackgroundBorderless"
      android:background="@color/navy_900"
      />

  <!-- Floating Day / Sepia / Night reading-mode switcher -->
  <LinearLayout
      android:id="@+id/reading_mode_bar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_above="@id/audio_area"
      android:layout_centerHorizontal="true"
      android:layout_marginBottom="16dp"
      android:background="@drawable/bg_reading_mode_bar"
      android:orientation="horizontal"
      android:padding="5dp"
      android:elevation="6dp">

    <TextView
        android:id="@+id/reading_mode_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:text="@string/reading_mode_day" />

    <TextView
        android:id="@+id/reading_mode_sepia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:text="@string/reading_mode_sepia" />

    <TextView
        android:id="@+id/reading_mode_night"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:text="@string/reading_mode_night" />
  </LinearLayout>
</com.medoapps.www.onlinequran.view.FitSystemRelativeLayout>
