<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlistItemRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/playlist_item_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Surah number -->
    <TextView
        android:id="@+id/txtSurahNumber"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Surah name -->
    <TextView
        android:id="@+id/txtSurahName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Now-playing indicator (visible only for current track) -->
    <ImageView
        android:id="@+id/imgNowPlaying"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/btn_play"
        app:tint="@color/gold_accent"
        android:visibility="gone" />
</LinearLayout>
