<?xml version="1.0" encoding="utf-8"?>
<!--
  More page. See design/specs/more-page.md and design/mockups/more-page.html.

  The RelativeLayout root and @id/EntireLayoutCategory are LOAD-BEARING: the Live
  Streaming entry replaces a LiveList fragment into this container, so the id must
  survive any redesign. The AdView is likewise kept (spec Q8) - it is gone by
  default and loadAd is not called, so it does not alter the rendered screen.

  Hero is hero_static, matching all 11 other hero screens; hero_collapsing would
  collide with MainActivity's own @+id/appbar (spec, Q2 correction).

  layoutDirection is "locale", not the hardcoded "rtl" this file used to carry -
  that forced Arabic layout onto English users.
-->
<RelativeLayout xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/EntireLayoutCategory"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:layoutDirection="locale"
    tools:context=".OtherCategoryFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/moreHero"
            layout="@layout/hero_static" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/more_list_bottom_pad"
                android:scrollbars="none" />

            <!-- Search-empty state (spec sec.5). Hero stays visible; only the
                 list body is replaced. -->
            <LinearLayout
                android:id="@+id/moreEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:visibility="gone">

                <TextView
                    android:id="@+id/moreEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textDirection="locale" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/moreEmptyClear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:minHeight="48dp"
                    android:text="@string/more_search_clear"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>
        </FrameLayout>

        <!-- Kept per spec Q8: gone by default, loadAd not called. -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:visibility="gone"
            ads:adSize="BANNER"
            ads:adUnitId="@string/banner_ad_unit_id" />

    </LinearLayout>
</RelativeLayout>
