<?xml version="1.0" encoding="utf-8"?>
<!--
  More page. See design/specs/more-page.md and design/mockups/more-page.html.

  The RelativeLayout root and @id/EntireLayoutCategory are LOAD-BEARING: the Live
  Streaming entry replaces a LiveList fragment into this container, so the id must
  survive any redesign. The AdView is likewise kept (spec Q8) - it is gone by
  default and loadAd is not called, so it does not alter the rendered screen.

  Hero is hero_static, matching all 11 other hero screens; hero_collapsing would
  collide with MainActivity's own @+id/appbar (spec, Q2 correction).

  layoutDirection is "locale", not the hardcoded "rtl" this file used to carry -
  that forced Arabic layout onto English users.
-->
<RelativeLayout xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/EntireLayoutCategory"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:layoutDirection="locale"
    tools:context=".OtherCategoryFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Screen-local header. hero_static cannot express the mockup: its compact
             variant is a single toolbar row with an ICONIFIED search, and its expanded
             variant stacks avatar+title BELOW the action row. The mockup wants avatar +
             title + actions on one row and an expanded search field beneath. Reshaping
             hero_static would hit the 11 screens that share it. -->
        <LinearLayout
            android:id="@+id/moreHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_navy_hero"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/moreAvatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:src="@mipmap/ic_launcher_new_transparent9"
                    app:civ_border_color="@color/gold_accent"
                    app:civ_border_width="1.5dp" />

                <TextView
                    android:id="@+id/moreTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/more_tab_header"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/text_on_navy"
                    android:textDirection="locale"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/moreRewards"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_rewards"
                    android:padding="13dp"
                    app:srcCompat="@drawable/outline_emoji_events_24"
                    app:tint="@color/gold_light" />

                <ImageButton
                    android:id="@+id/moreSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_settings"
                    android:padding="13dp"
                    app:srcCompat="@drawable/ic_settings_gear"
                    app:tint="@color/gold_light" />
            </LinearLayout>

            <!-- Expanded search field, as drawn - not an iconified lens. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_more_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:importantForAccessibility="no"
                    app:srcCompat="@android:drawable/ic_menu_search"
                    app:tint="@color/hint_on_navy" />

                <EditText
                    android:id="@+id/moreSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/more_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_on_navy"
                    android:textColorHint="@color/hint_on_navy"
                    android:textDirection="locale"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/more_list_bottom_pad"
                android:scrollbars="none" />

            <!-- Search-empty state (spec sec.5). Hero stays visible; only the
                 list body is replaced. -->
            <LinearLayout
                android:id="@+id/moreEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:visibility="gone">

                <TextView
                    android:id="@+id/moreEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textDirection="locale" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/moreEmptyClear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:minHeight="48dp"
                    android:text="@string/more_search_clear"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>
        </FrameLayout>

        <!-- Kept per spec Q8: gone by default, loadAd not called. -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:visibility="gone"
            ads:adSize="BANNER"
            ads:adUnitId="@string/banner_ad_unit_id" />

    </LinearLayout>
</RelativeLayout>
