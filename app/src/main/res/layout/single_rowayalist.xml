<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@color/transparent"
    android:paddingBottom="2dp"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="2dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/ripple_card"
        app:cardElevation="@dimen/card_elevation_default"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/background_card"
        app:cardPreventCornerOverlap="true"
        app:contentPadding="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/selectCheckBox"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="5dp"
                android:buttonTint="@color/gold_accent"
                android:clickable="false"
                android:visibility="gone" />

            <!-- Design-C decorative medallion holding the surah number -->
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="11dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_medallion_diamond" />

                <TextView
                    android:id="@+id/surahNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/gold_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="1" />
            </FrameLayout>

            <!-- Arabic surah name leads; metadata as chips beneath -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:transitionName="shared_surah"
                    android:text="Large Text"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAyah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_listrow_badge"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/gold_accent"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        tools:text="7 آية" />

                    <ImageView
                        android:id="@+id/statusIcon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="3dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_gold_outline"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="Medium Text"
                        android:textColor="@color/gold_accent"
                        android:textStyle="bold"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Trailing actions (IDs preserved) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    app:tint="@color/gold_accent"
                    android:transitionName="shared_surah_image"
                    android:src="@drawable/btn_play" />

                <ImageButton
                    android:id="@+id/buttonShare"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/downlaod"
                    app:srcCompat="@drawable/btn_share"
                    app:tint="@color/icon_secondary" />

                <ImageButton
                    android:id="@+id/button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/downlaod"
                    app:srcCompat="@drawable/btn_download"
                    app:tint="@color/icon_secondary" />

                <ImageButton
                    android:id="@+id/buttonDelete"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_delete"
                    app:tint="@color/md_theme_light_error" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardviewad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layoutDirection="rtl"
        app:cardBackgroundColor="@color/background_card"
        app:cardElevation="@dimen/card_elevation_default"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardCornerRadius="16dp"
        app:cardPreventCornerOverlap="true">

    </androidx.cardview.widget.CardView>

</RelativeLayout>
