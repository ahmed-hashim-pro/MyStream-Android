<?xml version="1.0" encoding="utf-8"?>
<!-- Reciter / surah row (mockup 16): text block first, the action disc
     (download / delete / check / select-box) at the trailing end. Mirrors via
     start/end under the activities' layoutDirection="locale". -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/quran_row_background"
                android:orientation="horizontal"
    >

  <ImageView
      android:id="@+id/image"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_marginStart="16dp"
      android:scaleType="center"
      android:layout_centerVertical="true"
      android:layout_alignParentEnd="true"
      android:src="@drawable/ic_download"
      android:background="@drawable/download_button_circle"
      android:contentDescription="@null"
      />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_centerVertical="true"
      android:layout_alignParentStart="true"
      android:layout_toStartOf="@id/image"
      android:orientation="vertical"
      >
    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/amiri_bold"
        android:textAppearance="@style/TitleText"
        android:textSize="17sp"
        />
    <TextView
        android:id="@+id/quantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        />
  </LinearLayout>
</RelativeLayout>
