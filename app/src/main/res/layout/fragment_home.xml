<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/home_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/home_collapsing"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:minHeight="?attr/actionBarSize"
            android:background="@drawable/bg_header_navy"
            android:fitsSystemWindows="true"
            app:contentScrim="@color/navy_700"
            app:statusBarScrim="@color/navy_700"
            app:titleEnabled="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <!-- Faint gold filigree watermark behind the header content -->
            <ImageView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="-40dp"
                android:alpha="0.07"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_filigree_arch"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5"
                app:tint="@color/gold_accent" />

            <!-- Expanded header content: wrap_content+top so children stack tightly from the inset -->
            <LinearLayout
                android:id="@+id/home_header_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.3">

                <!-- Top row: avatar + greeting/name + streak pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/home_avatar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:src="@mipmap/ic_launcher_new_transparent9"
                        app:civ_border_color="@color/gold_accent"
                        app:civ_border_width="1.5dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"
                            android:text="@string/home_greeting"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/home_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Hashim" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/home_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_listrow_badge"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/gold_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="🔥 7" />
                </LinearLayout>

                <!-- Glass next-prayer hero card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hero_card"
                    style="@style/Widget.MyStream.GlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/hero_next_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.75"
                                android:letterSpacing="0.12"
                                android:text="@string/home_hero_next"
                                android:textColor="@color/gold_accent"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hero_prayer_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#FFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="المغرب" />

                            <TextView
                                android:id="@+id/hero_prayer_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.85"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                tools:text="18:42" />
                        </LinearLayout>

                        <com.medoapps.www.onlinequran.ui.home.PrayerCountdownRingView
                            android:id="@+id/hero_ring"
                            android:layout_width="110dp"
                            android:layout_height="110dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hijri + Gregorian caption -->
                <TextView
                    android:id="@+id/home_hijri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.85"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="14 Dhul-Hijjah 1447" />

                <!-- 5-dot prayer progress strip -->
                <LinearLayout
                    android:id="@+id/prayer_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/dot_prayer_filled" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/dot_prayer_filled" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/dot_prayer_outline" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/dot_prayer_outline" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_prayer_outline" />
                </LinearLayout>
            </LinearLayout>

            <!-- Collapsed pin bar. Background is transparent when expanded;
                 contentScrim on CTL paints navy once collapsed. -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/home_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:minHeight="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:titleTextColor="#FFFFFF" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- §4.2 Continue Reading (restyled: navy Feature card, gold progress, resume button) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_continue"
                style="@style/Widget.MyStream.Card.Feature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Thin gold progress bar at the top of the card -->
                    <ProgressBar
                        android:id="@+id/continue_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginBottom="10dp"
                        android:max="604"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_continue_progress" />

                    <!-- Text row: subtitle + title on the left, resume button on the right -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/continue_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.7"
                                android:text="@string/home_continue_subtitle"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/continue_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="صفحة 255 · البقرة" />
                        </LinearLayout>

                        <!-- Circular gold resume button -->
                        <ImageView
                            android:id="@+id/continue_resume"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_continue_resume"
                            android:contentDescription="@string/home_continue_reading"
                            android:padding="10dp"
                            android:src="@drawable/round_play_arrow_24"
                            app:tint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- §4.3 Reading streak + daily-goal arc -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_stat"
                style="@style/Widget.MyStream.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Circular progress arc (gold) -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/stat_arc"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="16dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="@color/gold_accent"
                        app:indicatorSize="72dp"
                        app:trackColor="@color/gold_accent_faint"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />

                    <!-- Right side: pages text + streak dots + streak count -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stat_pages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="4 / 7 صفحات" />

                        <!-- 7-dot streak row -->
                        <LinearLayout
                            android:id="@+id/streak_dots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/streak_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="13sp"
                            tools:text="7 يوم" />

                        <!-- Empty-state nudge: shown only when today_pages==0 AND streak_days==0 -->
                        <TextView
                            android:id="@+id/streak_nudge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/home_reading_nudge"
                            android:textColor="@color/gold_accent"
                            android:textSize="12sp"
                            android:textStyle="italic"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- §4.4 5-prayer timeline: horizontal rail Fajr·Dhuhr·Asr·Maghrib·Isha -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_prayer_timeline"
                style="@style/Widget.MyStream.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/home_prayer_timeline_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:alpha="0.75" />

                    <!-- Nodes are added programmatically in HomeFragment.bindPrayerTimeline() -->
                    <LinearLayout
                        android:id="@+id/prayer_timeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- §4.5 Now-playing radio (navy card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/radio_card"
                style="@style/Widget.MyStream.RadioNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Station thumbnail (circle, Glide-loaded) -->
                    <ImageView
                        android:id="@+id/radio_thumb"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_listrow_badge"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/outline_radio_24" />

                    <!-- Station name + live badge -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/radio_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="إذاعة محمد صديق المنشاوي" />

                        <!-- Live dot + label row -->
                        <LinearLayout
                            android:id="@+id/radio_live_dot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/dot_prayer_filled"
                                android:backgroundTint="#E53935" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="مباشر"
                                android:textColor="#E53935"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Equalizer placeholder (3 static gold bars) -->
                    <LinearLayout
                        android:id="@+id/radio_eq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingStart="8dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="3dp"
                            android:background="@color/gold_accent" />

                        <View
                            android:layout_width="4dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="3dp"
                            android:background="@color/gold_accent" />

                        <View
                            android:layout_width="4dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="3dp"
                            android:background="@color/gold_accent" />

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@color/gold_accent" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- §4.6 Verse of the Day -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/verse_card"
                style="@style/Widget.MyStream.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Gold quote glyph + section label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="❝"
                            android:textColor="@color/gold_accent"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="0.75"
                            android:text="آية اليوم"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Arabic ayah text (RTL, large) -->
                    <TextView
                        android:id="@+id/verse_arabic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:layoutDirection="rtl"
                        android:lineSpacingMultiplier="1.4"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="إِنَّ مَعَ الْعُسْرِ يُسْرًا" />

                    <!-- Reference chip -->
                    <TextView
                        android:id="@+id/verse_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_gravity="end"
                        android:background="@drawable/bg_listrow_badge"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/gold_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="الشرح ٦" />

                    <!-- English translation (muted) -->
                    <TextView
                        android:id="@+id/verse_translation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:alpha="0.7"
                        android:lineSpacingMultiplier="1.3"
                        android:textSize="13sp"
                        tools:text="Indeed, with hardship will be ease." />

                    <!-- Ghost action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/verse_copy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:drawableStart="@drawable/round_content_copy_24"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/gold_accent"
                            android:paddingStart="8dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="6dp"
                            android:text="نسخ"
                            android:textColor="@color/gold_accent"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/verse_listen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:drawableStart="@drawable/round_play_arrow_24"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/gold_accent"
                            android:paddingStart="8dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="6dp"
                            android:text="استمع"
                            android:textColor="@color/gold_accent"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick actions (§4.7): rounded elevated cards, gold line-icons, gold-faint press -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="-5dp">

                <LinearLayout android:id="@+id/qa_quran" style="@style/Widget.MyStream.QuickAction">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:srcCompat="@drawable/holyquran"
                        app:tint="@color/gold_accent"
                        android:contentDescription="@string/qa_label_mushaf" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/qa_label_mushaf"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/qa_radio" style="@style/Widget.MyStream.QuickAction">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:srcCompat="@drawable/outline_radio_24"
                        app:tint="@color/gold_accent"
                        android:contentDescription="@string/qa_label_radio" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/qa_label_radio"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- qa_athan id kept; now routes to AthkarActivity (§4.7 mapping) -->
                <LinearLayout android:id="@+id/qa_athan" style="@style/Widget.MyStream.QuickAction">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:srcCompat="@drawable/ic_athkar"
                        app:tint="@color/gold_accent"
                        android:contentDescription="@string/qa_label_athkar" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/qa_label_athkar"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- qa_athkar id kept; now routes to QiblaActivity (§4.7 mapping) -->
                <LinearLayout android:id="@+id/qa_athkar" style="@style/Widget.MyStream.QuickAction">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:srcCompat="@drawable/ic_qibla"
                        app:tint="@color/gold_accent"
                        android:contentDescription="@string/qa_label_qibla" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/qa_label_qibla"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================================ -->
            <!-- Discover band (§4.9): two feature cards                      -->
            <!-- ============================================================ -->
            <LinearLayout
                style="@style/Widget.MyStream.SectionHeader">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.MyStream.SectionHeader.Title"
                    android:text="اكتشف" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Discover: Athkar (§4.9) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/discover_athkar"
                    style="@style/Widget.MyStream.Discover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:rippleColor="@color/gold_accent_faint">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:srcCompat="@drawable/ic_athkar"
                            app:tint="@color/gold_accent"
                            android:contentDescription="@null"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/discover_athkar_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingMultiplier="1.2"
                            android:maxLines="2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Discover: Islamic Events (§4.9) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/discover_events"
                    style="@style/Widget.MyStream.Discover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:rippleColor="@color/gold_accent_faint">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:srcCompat="@drawable/ic_islamic_events"
                            app:tint="@color/gold_accent"
                            android:contentDescription="@null"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/discover_events_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingMultiplier="1.2"
                            android:maxLines="2"
                            android:layout_marginBottom="8dp" />

                        <!-- Upcoming chip -->
                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/discover_events_chip"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@color/gold_accent_faint"
                            app:chipStrokeColor="@color/gold_accent"
                            app:chipStrokeWidth="1dp"
                            android:textColor="@color/gold_accent"
                            app:ensureMinTouchTargetSize="false"
                            style="@style/Widget.Material3.Chip.Suggestion" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
