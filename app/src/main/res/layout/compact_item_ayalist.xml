<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@color/transparent"
    android:paddingBottom="1dp"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="1dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/ripple_card_compact"
        app:cardElevation="0dp"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/background_card"
        app:cardPreventCornerOverlap="true"
        app:contentPadding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/selectCheckBox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:buttonTint="@color/gold_accent"
                android:clickable="false"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                app:tint="@color/gold_accent"
                android:src="@drawable/btn_play" />

            <TextView
                android:id="@+id/textView1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="4dp"
                android:paddingStart="4dp"
                android:text="Large Text"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Medium Text"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />

            <ImageButton
                android:id="@+id/buttonShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/btn_share"
                app:tint="@color/icon_secondary" />

            <ImageButton
                android:id="@+id/button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/btn_download"
                app:tint="@color/icon_secondary" />

            <ImageButton
                android:id="@+id/buttonDelete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_delete"
                app:tint="@color/md_theme_light_error" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardviewad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layoutDirection="rtl"
        app:cardBackgroundColor="@color/background_card"
        app:cardElevation="@dimen/card_elevation_default"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardCornerRadius="8dp"
        app:cardPreventCornerOverlap="true">

    </androidx.cardview.widget.CardView>

</RelativeLayout>
