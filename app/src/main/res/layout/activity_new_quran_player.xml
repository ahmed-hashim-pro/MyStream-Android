<RelativeLayout
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@color/quran_player_background"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".NewQuranPlayer">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/PlayerCard"
        android:layout_below="@+id/layoutads"
        android:gravity="center">


        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:focusableInTouchMode="true"
            android:hapticFeedbackEnabled="true"
            ads:cardBackgroundColor="@color/transparent"
            app:cardElevation="200dp"
            app:cardMaxElevation="300dp"
            app:cardPreventCornerOverlap="true">
            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:elevation="60dp"
                android:transitionName="shared_surah_image"
                android:background="@drawable/quran_circle_background"
                ads:srcCompat="@drawable/quranpng" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/quran_toolbar_background"
        android:minHeight="?attr/actionBarSize"
        android:layoutDirection="locale"
        android:theme="@style/AppTheme.QuranMediaPlayer">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <ImageButton
                android:id="@+id/backBTN"
                android:layout_width="wrap_content"
                android:layout_height="?attr/actionBarSize"
                android:background="@null"
                android:onClick="BUClick"
                android:tint="@color/toolbarTextColor"
                ads:srcCompat="@drawable/outline_arrow_back_ios_24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:gravity="center">
                <TextView
                    android:id="@+id/songTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/actionBarSize"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="15dp"
                    android:ellipsize="marquee"
                    android:fadingEdge="horizontal"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:gravity="center"
                    android:text="   "
                    android:textColor="@color/toolbarTextColor"
                    android:textSize="16dp"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:transitionName="shared_surah" />

            </LinearLayout>

            <TextView
                android:id="@+id/songrecite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:transitionName="shared_reciter"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="3dp"
                android:gravity="center"
                android:text="  "
                android:textColor="@color/toolbarTextColor"
                android:textSize="13dp"
                android:textStyle="bold" />

        </RelativeLayout>
