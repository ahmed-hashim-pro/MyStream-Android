<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed reciter block for the STOPPED audio bar (mockup 18 A): bold name
     with the gold caret, status subline underneath. Tapping opens the picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical|start"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/ic_caret_down_gold"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text_on_navy"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/audiobar_ready_hint"
        android:textColor="@color/hint_on_navy"
        android:textSize="10.5sp" />
</LinearLayout>
