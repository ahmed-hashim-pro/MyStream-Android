<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/softBlue"

    android:orientation="vertical"
    tools:context="com.medoapps.www.onlinequran.DownloadsPlayer">

    <RelativeLayout
        android:id="@+id/player_header_bg"
        android:layout_width="fill_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_weight="0"
        android:background="@drawable/bg_player_header"
        android:orientation="vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp">

        <!-- Song Title -->

        <TextView
            android:id="@+id/songTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"

            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:text="بدون عنوان"
            android:textColor="#04b3d2"
            android:textSize="16dp"
            android:textStyle="bold" />



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="@string/sound" />

            <Spinner
                android:id="@+id/spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                />

        </RelativeLayout>


    </RelativeLayout>

    <LinearLayout xmlns:ads="http://schemas.android.com/apk/res-auto"
        android:id="@+id/layoutads"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_weight="0"
        android:background="@color/softBlue"
        android:orientation="vertical">

        <com.google.android.gms.ads.AdView
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:visibility="gone"
            ads:adSize="BANNER"
            ads:adUnitId="@string/banner_ad_unit_id">

        </com.google.android.gms.ads.AdView>


    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollvissP"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_weight="0"
        android:background="@color/softBlue"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/linearLayoutVisual"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"></LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@color/softBlue"
        android:layout_weight="0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <LinearLayout
                android:id="@+id/linearLayoutEqual"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical"
                ></LinearLayout>
        </LinearLayout>
    </ScrollView>



    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="8dp"
        tools:layout_editor_absoluteY="11dp"
        android:background="@color/softBlue"
        android:paddingBottom="30dp"/>
    <LinearLayout
        android:id="@+id/timerDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="@color/softBlue"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/songCurrentDurationP"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songTotalDurationP"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="@drawable/rounded_corner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingRight="5dp">
        <!-- Previous Button -->
        <ImageButton
            android:id="@+id/btPvP"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:src="@drawable/btn_previous" />
        <!-- Backward Button -->
        <ImageButton
            android:id="@+id/btFbP"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:src="@drawable/btn_backward" />
        <!-- Play Button -->
        <ImageButton
            android:id="@+id/btPlayP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:src="@drawable/btn_play" />
        <!-- Forward Button -->
        <ImageButton
            android:id="@+id/btFfP"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:src="@drawable/btn_forward" />
        <!-- Next Button -->
        <ImageButton
            android:id="@+id/btNextP"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:src="@drawable/btn_next" />
    </LinearLayout>



</LinearLayout>
