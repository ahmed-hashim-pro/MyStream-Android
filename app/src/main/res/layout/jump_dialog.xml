<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick-jump dialog — navy+gold language (matches
  docs/.../mushaf-retheme/parts/10-jump.html): gold caption labels, rounded
  gold-outlined input boxes, muted helper lines, and a single filled-gold OK
  button. Inner field ids (page_number / sura_spinner / ayah_spinner) are kept
  so JumpFragment's wiring is unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

  <!-- Page number -->
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:letterSpacing="0.04"
      android:text="@string/gotoPage"
      android:textAllCaps="true"
      android:textColor="@color/gold_accent"
      android:textSize="11sp"
      android:textStyle="bold"/>

  <EditText
      android:id="@+id/page_number"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:background="@drawable/bg_input_box_gold"
      android:imeOptions="actionGo|flagNoExtractUi"
      android:inputType="number"
      android:maxLength="3"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:paddingTop="12dp"
      android:paddingBottom="12dp"/>

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:text="@string/jump_page_hint"
      android:textColor="@color/text_secondary"
      android:textSize="11sp"/>

  <!-- Surah · Ayah -->
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:letterSpacing="0.04"
      android:text="@string/menu_jump"
      android:textAllCaps="true"
      android:textColor="@color/gold_accent"
      android:textSize="11sp"
      android:textStyle="bold"/>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:orientation="horizontal">

    <com.medoapps.www.onlinequran.view.ForceCompleteTextView
        android:id="@+id/sura_spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_input_box_gold"
        android:drawablePadding="8dp"
        android:imeOptions="flagNoExtractUi"
        android:inputType="text|textAutoComplete"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:selectAllOnFocus="true"
        app:drawableEndCompat="@drawable/outline_expand_more_24"
        android:drawableTint="@color/gold_accent"/>

    <EditText
        android:id="@+id/ayah_spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_input_box_gold"
        android:gravity="center"
        android:imeOptions="flagNoExtractUi"
        android:inputType="number"
        android:minWidth="68dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:selectAllOnFocus="true"/>
  </LinearLayout>

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:text="@string/jump_sura_hint"
      android:textColor="@color/text_secondary"
      android:textSize="11sp"/>

  <!-- Single filled-gold OK (end-aligned; mirrors to the left in RTL) -->
  <com.google.android.material.button.MaterialButton
      android:id="@+id/jump_ok"
      style="@style/Widget.Material3.Button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="end"
      android:layout_marginTop="18dp"
      android:text="@string/dialog_ok"
      android:textColor="@color/text_on_gold"
      app:backgroundTint="@color/gold_accent"/>
</LinearLayout>
