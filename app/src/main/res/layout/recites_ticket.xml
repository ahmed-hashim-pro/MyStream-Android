<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/transparent"
    android:orientation="vertical"
    android:paddingBottom="2dp"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="2dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/ripple_card"
        app:cardElevation="@dimen/card_elevation_default"
        android:layoutDirection="rtl"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/background_card"
        app:cardPreventCornerOverlap="true"
        app:contentPadding="12dp">

        <LinearLayout
            android:id="@+id/entireCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgchannel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="0"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:src="@drawable/ramadan_quran"
                app:tint="@color/gold_accent" />

            <TextView
                android:id="@+id/txtRecitesName"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:transitionName="shared_reciter"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/imgchannel"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:paddingEnd="7dp"
                android:paddingStart="7dp"
                android:text="Large Text"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/buttonShare"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/downlaod"
                android:layout_gravity="center"
                app:srcCompat="@drawable/btn_share"
                app:tint="@color/icon_secondary" />
            <!--<ImageView
                android:id="@+id/imageView"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_gravity="center"
                android:layout_weight="0"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:rotationY="180"
                android:visibility="gone"
                android:src="@drawable/backirrow" />-->
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardviewad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layoutDirection="rtl"
        android:visibility="gone"
        app:cardBackgroundColor="@color/background_card"
        app:cardElevation="@dimen/card_elevation_default"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardCornerRadius="12dp"
        app:cardPreventCornerOverlap="true">

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/youtubeCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:foreground="@drawable/ripple_card"
        app:cardElevation="@dimen/card_elevation_default"
        app:cardMaxElevation="@dimen/card_elevation_raised"
        app:cardBackgroundColor="@color/background_card"
        app:cardCornerRadius="12dp"
        android:layoutDirection="ltr"
        app:cardPreventCornerOverlap="true"
        android:visibility="gone"
        android:focusableInTouchMode="true">
        <RelativeLayout
            android:id="@+id/EntireLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <include
                android:id="@+id/hh"
                layout="@layout/include_post_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="5dp"
                android:visibility="gone"
                android:layout_marginTop="10dp" />
            <RelativeLayout
                android:id="@+id/two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        app:cardElevation="20dp"
                        android:layoutDirection="rtl"
                        app:cardMaxElevation="12dp"
                        app:cardPreventCornerOverlap="true"
                        android:focusableInTouchMode="true"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                >

                                <com.google.android.youtube.player.YouTubeThumbnailView
                                    android:id="@+id/playerthu2"
                                    android:layout_width="match_parent"
                                    android:scaleType="fitXY"
                                    android:visibility="gone"
                                    android:layout_height="700px"/>

                                <ImageView
                                    android:id="@+id/imageView5"
                                    android:layout_width="match_parent"
                                    android:layout_height="810px"
                                    android:layout_marginEnd="-15dp"
                                    android:scaleType="fitXY"
                                    app:srcCompat="@drawable/backgroundimage" />

                                <ImageView
                                    android:layout_width="200px"
                                    android:layout_height="200px"
                                    android:layout_centerInParent="true"
                                    android:layout_gravity="center"
                                    android:elevation="200dp"
                                    android:textAlignment="center"
                                    app:srcCompat="@drawable/round_play_arrow_24" />
                            </RelativeLayout>

                        </LinearLayout>



                    </androidx.cardview.widget.CardView>
                    <!--<androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"


                        app:cardBackgroundColor="@color/white"
                        android:layoutDirection="rtl"


                        android:layout_gravity="bottom"

                        app:contentPadding="2dp">

                    </androidx.cardview.widget.CardView>-->
                </LinearLayout>

                <ImageView
                    android:id="@+id/Thumb_Image"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"

                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:scaleType="fitXY"
                    android:background="@color/black"
                    android:src="@drawable/mystream" />
                <ImageView

                    android:layout_width="50dp"
                    android:layout_height="50dp"

                    android:visibility="gone"
                    android:layout_centerHorizontal="true"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="10dp"
                    android:scaleType="fitXY"

                    android:src="@drawable/ic_play_arrow_black_24dp" />



            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/userArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/two"
                android:layout_marginStart="7dp"
                android:layout_marginTop="5dp"
                android:paddingTop="7px"
                android:paddingBottom="10px"
                android:layout_marginBottom="2dp">

                <include
                    android:id="@+id/post_author_layout"
                    layout="@layout/include_youtube_post_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layoutDirection="ltr"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/titleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10px"
                    android:paddingEnd="10px"
                    android:paddingStart="10px"
                    android:layout_toEndOf="@+id/post_author_layout"
                    android:layout_toStartOf="@+id/option_layout2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView13"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="Loading..."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:paddingStart="9dp"
                        android:paddingTop="4px"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4px"
                        android:text="" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/option_layout2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/post_author_layout"
                    android:layout_alignBottom="@+id/post_author_layout"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/option"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="5dp"
                        android:background="?attr/selectableItemBackground"
                        android:onClick="showPopup"
                        android:src="@drawable/baseline_more_vert_24" />


                </LinearLayout>
            </RelativeLayout>


            <LinearLayout
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:orientation="horizontal"
                android:layout_below="@+id/userArea"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:background="@color/divider_gold">

            </LinearLayout>
            <LinearLayout
                android:id="@+id/interact"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_below="@+id/divider">
                <RelativeLayout
                    android:id="@+id/star_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_weight="4"
                    android:layout_gravity="center"
                    android:textAlignment="center"
                    android:background="@drawable/btn_like"
                    android:elevation="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/star"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@+id/post_num_stars"
                        android:background="?attr/selectableItemBackground"
                        android:src="@drawable/ic_toggle_star_outline_24" />

                    <TextView
                        android:id="@+id/post_num_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="3dp"
                        android:gravity="center"
                        tools:text="75" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/share_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_weight="4"
                    android:layout_gravity="center"
                    android:textAlignment="center"
                    android:background="@drawable/btn_like"
                    android:elevation="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:background="?attr/selectableItemBackground"
                        android:src="@drawable/outline_share_24" />


                </RelativeLayout>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    android:orientation="horizontal"


                    >

                    <TextView
                        android:id="@+id/views"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:text="11"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="10dp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/views"
                        android:src="@drawable/outline_visibility_24" />
                </RelativeLayout>
            </LinearLayout>



        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</RelativeLayout>