<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <TextView android:id="@+id/search_warning"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@color/gold_accent_faint"
              android:padding="12dp"
              android:textSize="15sp"
              android:visibility="gone"
              android:textColor="?android:textColorPrimary" />
    <Button android:id="@+id/btnGetTranslations" android:text="@string/menu_get_translations"
    	android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>

  <TextView
      android:id="@+id/search_area"
      android:layout_width="fill_parent"
      android:layout_height="wrap_content"
      android:background="@color/navy_700"
      android:padding="12dp"
      android:text="@string/search_key"
      android:textColor="@color/text_on_navy"
      android:textSize="15sp" />

    <ListView
            android:id="@+id/results_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
</LinearLayout>
