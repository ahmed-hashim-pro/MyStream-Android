<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">


    <de.hdodenhof.circleimageview.CircleImageView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/comment_photo"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_action_account_circle_40"
        app:civ_border_color="#FF000000"
        app:civ_border_width="1dp" />

    <LinearLayout
        android:id="@+id/textShowForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/comment_photo"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="3"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/comment_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/toolbarTextColor"
                android:textStyle="bold"
                tools:text="Ahmed Hashim" />

            <TextView
                android:id="@+id/comment_body"
                style="@style/TextAppearance.AppCompat.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/whiteback"
                tools:text="This is the comment text.." />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/option_layout2"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_weight="0.2"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/option"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingLeft="10dp"
                android:paddingRight="5dp"
                android:onClick="showPopup"
                android:tint="@color/toolbarTextColor"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/baseline_more_vert_24" />



        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/comment_edit_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_toRightOf="@+id/comment_photo"
        >

        <EditText
            android:id="@+id/field_comment_update_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:hint="@string/WriteComment"
            android:imeOptions="actionSend|flagNoEnterAction"
            android:maxLines="1"
            android:textColor="@color/toolbarTextColor"
            android:textColorHint="@color/textHint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/button_update_comment"
                style="@style/Base.Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.2"
                android:textColor="@color/whiteback"
                android:text="@string/update" />
            <Button
                android:id="@+id/button_comment_cancel"
                style="@style/Base.Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.2"
                android:textColor="@color/whiteback"
                android:text="@string/cancel" />
        </LinearLayout>


    </LinearLayout>


</RelativeLayout>
