<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layoutDirection="ltr"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:background="@color/background_app_bar"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_height="?attr/actionBarSize"
            android:layout_width="match_parent"
            android:background="@drawable/main_app_bar"
            ads:layout_scrollFlags="scroll|enterAlways|snap">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="center_vertical">

                <RelativeLayout
                    android:id="@+id/user_photo_layout"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true">

                    <de.hdodenhof.circleimageview.CircleImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/user_photo"
                        android:layout_width="50dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/mystream"
                        app:civ_border_color="#D4A44C"
                        app:civ_border_width="2dp" />

                    <ImageView
                        android:id="@+id/crown_photo"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="-4dp"
                        android:layout_marginEnd="-2dp"
                        android:rotation="37"
                        android:src="@drawable/crown" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="60dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/User_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_hijri_date_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gold_accent"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:onClick="option"
                    app:tint="@color/icon_primary"
                    ads:srcCompat="@drawable/outline_reorder_24" />

                <ImageView
                    android:id="@+id/prize"
                    android:layout_width="25dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="47dp"
                    android:background="@null"
                    app:tint="@color/gold_accent"
                    ads:srcCompat="@drawable/outline_emoji_events_24" />

                <Button
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="85dp"
                    android:layout_toStartOf="@+id/prize"
                    android:background="@drawable/messenger_bubble_large_blue"
                    android:onClick="message"
                    android:visibility="gone" />
            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>
        <androidx.cardview.widget.CardView
            android:id="@+id/completeProfileCard"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="2dp"
            ads:cardBackgroundColor="@color/warning_banner_bg"
            android:layout_below="@+id/watchtitleCard"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardPreventCornerOverlap="true"
            android:layoutDirection="locale"
            app:contentPadding="2dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    ads:srcCompat="@drawable/outline_arrow_forward_ios_24"
                    android:layout_alignParentEnd="true"
                    ads:tint="@color/gold_accent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:gravity="center"
                    android:text="@string/complete_your_profile"
                    android:textAlignment="center"
                    android:textColor="@color/gold_accent"
                    android:textStyle="bold" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/subscribeCard"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="2dp"
            ads:cardBackgroundColor="@color/warning_banner_bg"
            android:layout_below="@+id/watchtitleCard"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardPreventCornerOverlap="true"
            android:layoutDirection="locale"
            app:contentPadding="2dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    ads:srcCompat="@drawable/outline_arrow_forward_ios_24"
                    android:layout_alignParentEnd="true"
                    ads:tint="@color/gold_accent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:gravity="center"
                    android:text="All Services Are Free, Want To Support App ?"
                    android:textAlignment="center"
                    android:textColor="@color/gold_accent"
                    android:textStyle="bold" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Non-scrolling container so each tab fragment manages its own scrolling
         (the Home hub is a CoordinatorLayout; wrapping it in a NestedScrollView
         trapped its scroll). Keeps ScrollingViewBehavior so it sits below the app bar. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp"
        ads:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <RelativeLayout
            android:id="@+id/adLayoutMain"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="1dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="0dp">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_host_fragment"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/nav_bottom_anchor"
                android:layout_alignParentTop="true"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="-2dp"
                app:defaultNavHost="true"
                app:navGraph="@navigation/mobile_navigation" />

            <!-- Stable 0dp bottom anchor so the NavHost fills to the tab bar
                 independently of the ad banner's state. -->
            <View
                android:id="@+id/nav_bottom_anchor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_alignParentBottom="true" />

            <!-- Bottom banner hidden for now; kept (with the loader in MainActivity) to
                 re-activate later: set visibility back to visible and re-enable loadBannerAd(). -->
            <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:visibility="gone"
                android:background="@color/transparent"
                ads:adSize="BANNER"
                ads:adUnitId="@string/banner_ad_unit_id" />

        </RelativeLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="120dp"
        android:layout_marginEnd="15dp"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_new_post"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:elevation="100dp"
            android:src="@drawable/plus"
            android:stateListAnimator="@null"
            android:translationZ="2dp"
            ads:backgroundTint="@color/gold_accent"
            app:tint="@color/text_on_gold" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_new_youtube_post"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:elevation="100dp"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="7dp"
            android:src="@drawable/outline_ondemand_video_24"
            android:stateListAnimator="@null"
            android:translationZ="2dp"
            ads:backgroundTint="@color/gold_accent"
            app:tint="@color/text_on_gold" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/admin_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="120dp"
        android:layout_marginEnd="15dp"
        android:contentDescription="extended_fab_content_desc"
        android:text="@string/admin_panel"
        app:backgroundTint="@color/gold_accent"
        android:textColor="@color/text_on_gold"
        app:iconTint="@color/text_on_gold"
        app:icon="@drawable/outline_admin_panel_settings_24"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_above="@+id/adView"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:elevation="100dp"
        android:src="@drawable/plus"
        android:layout_marginBottom="60dp"
        android:layout_marginEnd="15dp"
        android:layout_gravity="bottom|end"
        android:stateListAnimator="@null"
        android:translationZ="2dp"
        ads:backgroundTint="@color/gold_accent"
        app:tint="@color/text_on_gold" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="12dp"
        android:background="@drawable/bg_pill_dock"
        app:elevation="8dp"
        app:itemIconTint="@drawable/bottom_navigation_color_selector"
        app:itemTextColor="@drawable/bottom_navigation_color_selector"
        app:itemActiveIndicatorStyle="@style/Widget.MyStream.BottomNav.ActiveIndicator"
        app:itemTextAppearanceActive="@style/TextAppearance.MyStream.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.MyStream.BottomNav.Inactive"
        app:itemIconSize="26dp"
        app:itemRippleColor="@color/gold_accent_faint"
        app:labelVisibilityMode="selected"
        android:layout_gravity="bottom"
        app:menu="@menu/menu_bottom_navigation" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
