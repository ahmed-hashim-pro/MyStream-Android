<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:theme="@style/AppTheme.SignIn"
    tools:context="com.medoapps.www.onlinequran.SignInActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_gravity="center">

        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardBackgroundColor="#00000000"
            app:cardPreventCornerOverlap="true"
            android:focusableInTouchMode="true"
            android:layout_gravity="bottom">

            <LinearLayout
                android:id="@+id/fff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="@string/cd_app_logo"
                    android:src="@drawable/mystream" />

                <TextView
                    android:id="@+id/textexolain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_horizontal"
                    android:text="@string/app_name"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/titleCard"
            android:paddingStart="@dimen/activity_horizontal_margin"
            android:paddingEnd="@dimen/activity_horizontal_margin">

            <LinearLayout
                android:id="@+id/bigger_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/OAuthLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/fff"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/emailSignInTap"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:backgroundTint="@color/background_input_button"
                        android:drawableStart="@drawable/outline_email_24"
                        android:drawableEnd="@drawable/outline_expand_more_24"
                        android:drawableTint="@color/text_primary"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="@string/sign_in_with_email"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:id="@+id/email_Login_Container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/field_email"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="7dp"
                            android:hint="@string/hint_email"
                            app:boxStrokeColor="@color/gold_accent"
                            app:hintTextColor="@color/text_hint"
                            app:endIconMode="clear_text"
                            app:endIconTint="@color/icon_secondary"
                            app:startIconContentDescription="content_description_end_icon"
                            app:startIconDrawable="@drawable/outline_email_24"
                            app:startIconTint="@color/icon_secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeActionId="665"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:inputType="textEmailAddress" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/field_password"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_password"
                            app:boxStrokeColor="@color/gold_accent"
                            app:hintTextColor="@color/text_hint"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/icon_secondary"
                            app:startIconContentDescription="content_description_end_icon"
                            app:startIconDrawable="@drawable/outline_lock_24"
                            app:startIconTint="@color/icon_secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionGo"
                                android:imeActionId="666"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:inputType="textPassword" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:id="@+id/layout_buttons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/layout_email_password2"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_sign_in"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:text="@string/sign_in"
                                android:textColor="@color/text_on_gold"
                                android:textStyle="bold"
                                app:backgroundTint="@color/gold_accent" />

                            <LinearLayout
                                android:id="@+id/checkPolicyLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layoutDirection="locale"
                                android:orientation="horizontal"
                                android:layout_marginBottom="7dp">

                                <CheckBox
                                    android:id="@+id/policyAcceptCheck"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:buttonTint="@color/gold_accent"
                                    android:checked="false" />

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layoutDirection="locale">

                                    <androidx.constraintlayout.helper.widget.Flow
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        app:constraint_referenced_ids="textView18,termsButton,textView19,privacyButton"
                                        app:flow_wrapMode="chain"
                                        app:flow_horizontalStyle="packed"
                                        app:flow_horizontalGap="0dp"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        android:layoutDirection="locale" />

                                    <TextView
                                        android:id="@+id/textView18"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="13sp"
                                        android:textColor="@color/text_secondary"
                                        android:text="@string/acceptPolicy1" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/termsButton"
                                        style="@style/Widget.Material3.Button.TextButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minHeight="0dp"
                                        android:minWidth="0dp"
                                        android:textSize="11sp"
                                        android:textColor="@color/gold_accent"
                                        android:padding="0dp"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="2dp"
                                        android:text="@string/terms_amp_conditions" />

                                    <TextView
                                        android:id="@+id/textView19"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="13sp"
                                        android:textColor="@color/text_secondary"
                                        android:text="@string/aceptPolicy2" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/privacyButton"
                                        style="@style/Widget.Material3.Button.TextButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/privacy_policy"
                                        android:textColor="@color/gold_accent"
                                        android:minHeight="0dp"
                                        android:minWidth="0dp"
                                        android:textSize="11sp"
                                        android:padding="0dp"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="2dp" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_sign_up"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:text="@string/btn_sign_up"
                                android:textColor="@color/text_primary"
                                app:backgroundTint="@color/background_input_button" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_buttons2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/layout_buttons"
                            android:layout_centerHorizontal="true"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_change_mode"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="@string/sign_up"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:text="@string/orby"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.gms.common.SignInButton
                        android:id="@+id/sign_in_button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal" />

                    <com.facebook.login.widget.LoginButton
                        android:id="@+id/buttonFacebookLogin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_sm" />

                </LinearLayout>

                <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/adView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:visibility="gone"
                    ads:adSize="BANNER"
                    ads:adUnitId="@string/banner_ad_unit_id" />

            </LinearLayout>
        </ScrollView>

    </RelativeLayout>

</RelativeLayout>
