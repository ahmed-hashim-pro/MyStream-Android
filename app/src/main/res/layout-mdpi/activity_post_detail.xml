<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:keepScreenOn="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    tools:context="com.medoapps.www.onlinequran.PostDetailActivity">
    <ImageView
        android:id="@+id/FullThumb"
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:scaleType="fitXY"
        android:src="@drawable/mystream"
        />
    <FrameLayout
        android:id="@+id/main_media_frame"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_weight="0.5"
        android:background="#000000">

        <com.google.android.exoplayer2.ui.StyledPlayerView
            android:id="@+id/exoplayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center" />

    </FrameLayout>
    <ScrollView
        android:layout_below="@+id/main_media_frame"
        android:layout_width="match_parent"
        android:layout_above="@+id/comment_form"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >


            <LinearLayout
                android:id="@+id/playerHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:orientation="horizontal"

                >


            </LinearLayout>
            <RelativeLayout
                android:id="@+id/sVideo"
                android:layout_width="match_parent"
                android:layout_below="@+id/playerHeight"
                android:layout_height="wrap_content">

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ad_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/sVideo"
                android:orientation="vertical"
                android:gravity="center"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:text="@string/Press_Add"
                     />

                <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/adView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    ads:adSize="BANNER"
                    ads:adUnitId="@string/banner_ad_unit_id">

                </com.google.android.gms.ads.AdView>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ad_layout"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="#cc040303">

                <androidx.cardview.widget.CardView
                    android:id="@+id/Viewlayout"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginBottom="2dp"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardElevation="20dp"
                    app:cardMaxElevation="20dp"
                    android:layoutDirection="ltr"
                    app:cardPreventCornerOverlap="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    >
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        >

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:orientation="horizontal"
                            >
                            <TextView
                                android:id="@+id/ViewsNum"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="11"
                                android:layout_toEndOf="@+id/eye"
                                android:layout_marginStart="10dp"
                                android:textColor="@color/toolbarTextColor"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/eye"
                                android:layout_width="20dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/outline_visibility_24"
                                app:tint="@color/toolbarTextColor" />

                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/option_layout2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/videoOption"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:paddingStart="10dp"
                                android:paddingEnd="5dp"
                                android:src="@drawable/baseline_more_vert_24"
                                app:tint="@color/toolbarTextColor" />


                        </LinearLayout>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <RelativeLayout
                    android:id="@+id/postAuther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/Viewlayout"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone"
                    android:paddingEnd="@dimen/activity_horizontal_margin">


                    <include
                        android:id="@+id/post_author_layout"
                        layout="@layout/include_post_author" />

                    <Button
                        android:id="@+id/showVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:onClick="ShowVideo"
                        android:text="@string/showVideo"
                        android:visibility="gone" />
                </RelativeLayout>


                <LinearLayout
                    android:id="@+id/postText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/postAuther"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp">

                    <include
                        android:id="@+id/post_text_layout"
                        layout="@layout/include_post_text"

                        />
                </LinearLayout>




                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_comments"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/postText"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:paddingStart="@dimen/activity_horizontal_margin"
                    android:paddingEnd="@dimen/activity_horizontal_margin"
                    android:paddingBottom="30dp"
                    tools:listitem="@layout/item_comment" />
            </RelativeLayout>




        </RelativeLayout>
    </ScrollView>


    <androidx.cardview.widget.CardView
        android:id="@+id/comment_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:cardElevation="20dp"
        app:cardMaxElevation="20dp"
        android:layoutDirection="ltr"
        app:cardPreventCornerOverlap="true"
        android:focusableInTouchMode="true"
        android:layout_marginTop="5dp"
        android:layout_alignParentBottom="true"

        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            >

            <EditText
                android:id="@+id/field_comment_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:hint="@string/WriteComment"
                android:imeOptions="actionSend|flagNoEnterAction"
                android:maxLines="1"
                android:textColorHint="@color/textHint" />

            <Button
                android:id="@+id/button_post_comment"
                style="@style/Base.Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.2"
                android:text="@string/post"

                android:textColor="@color/black" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</RelativeLayout>
