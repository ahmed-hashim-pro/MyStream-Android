<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <solid android:color="@color/navy_500" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/gold_accent" />
        </shape>
    </item>

    <item android:gravity="center_vertical|end" android:right="8dp">
        <layer-list>
            <item android:width="10dp" android:height="10dp" android:gravity="center" android:bottom="8dp">
                <rotate
                    android:fromDegrees="45"
                    android:toDegrees="45">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/gold_accent" />
                    </shape>
                </rotate>
            </item>
            <item android:width="26dp" android:height="8dp" android:bottom="18dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <solid android:color="@color/navy_500" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</layer-list>
