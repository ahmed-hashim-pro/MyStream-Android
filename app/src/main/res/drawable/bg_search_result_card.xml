<?xml version="1.0" encoding="utf-8"?>
<!-- Search result row as a navy-theme card (light & dark via background_card),
     with the mockup's hairline border so cards read against background_main. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/background_card" />
    <stroke
        android:width="1dp"
        android:color="@color/row_divider_hairline" />
    <corners android:radius="16dp" />
</shape>
