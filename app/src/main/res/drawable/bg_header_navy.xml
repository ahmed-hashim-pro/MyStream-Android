<?xml version="1.0" encoding="utf-8"?>
<!-- Home header (A .bn-hero): radial navy glow from the top-right corner,
     navy_500 → navy_700 → navy_900 floor, so the bottom reads darker. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.8"
        android:centerY="0.0"
        android:gradientRadius="440dp"
        android:startColor="@color/navy_500"
        android:centerColor="@color/navy_700"
        android:endColor="@color/navy_900" />
</shape>
