<?xml version="1.0" encoding="utf-8"?>
<!-- Gold gradient progress pill on the navy data-gate card (mockup .prog):
     6dp rounded track at 14% white, gold→gold-light fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_on_navy" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/gold_light"
                    android:startColor="@color/gold_accent" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
