<?xml version="1.0" encoding="utf-8"?>
<!-- Background-brightness preview swatch: rounded-6 with a hairline border; the
     fill color is mutated at runtime to the chosen page shade. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF000000" />
    <stroke
        android:width="1dp"
        android:color="@color/row_divider_hairline" />
    <corners android:radius="6dp" />
</shape>
