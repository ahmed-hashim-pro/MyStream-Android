<?xml version="1.0" encoding="utf-8"?>
<!-- Unified reader dropdown popup (approved mockup 06b/06c): navy card, gold-semi
     border, radius 14. The padding keeps row fills inside the rounded corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/navy_700" />
    <stroke android:width="1dp" android:color="@color/gold_accent_semi" />
    <corners android:radius="14dp" />
    <padding
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="4dp" />
</shape>
