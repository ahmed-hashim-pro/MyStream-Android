<?xml version="1.0" encoding="utf-8"?>
<!-- Context card ring. Sits on the permanently-navy card, so the stroke is
     gold_light rather than a theme attr - the card does not follow day/night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="2dp" android:color="@color/gold_light" />
</shape>
