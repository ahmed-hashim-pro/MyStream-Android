<?xml version="1.0" encoding="utf-8"?>
<!-- Navy-dropdown row: gold-faint band for the current (activated) value, hairline
     separator on top of every row (mockup 06b). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/gold_accent_faint" />
                </shape>
            </item>
            <item android:height="1dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#12FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:height="1dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#12FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
