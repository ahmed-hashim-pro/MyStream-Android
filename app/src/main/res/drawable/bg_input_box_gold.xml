<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined input box: transparent fill (shows the dialog surface, both themes)
     + gold hairline, rounded. For the quick-jump dialog fields. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/gold_accent" />
    <corners android:radius="10dp" />
</shape>
