<?xml version="1.0" encoding="utf-8"?>
<!-- Settings section card (mockup .card): surface fill, hairline border, 16dp
     radius. Drawn by PreferenceCardDecoration behind runs of preference rows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/background_card" />
    <stroke
        android:width="1dp"
        android:color="@color/row_divider_hairline" />
    <corners android:radius="16dp" />
</shape>
