<?xml version="1.0" encoding="utf-8"?>
<!-- Rows share one continuous surface; the decoration draws the hairlines between
     them. colorSurface alone was invisible against background_main in light. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorSurface" />
    <stroke android:width="@dimen/more_hairline" android:color="?attr/colorOutlineVariant" />
</shape>
