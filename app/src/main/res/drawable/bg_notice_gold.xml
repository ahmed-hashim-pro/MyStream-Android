<?xml version="1.0" encoding="utf-8"?>
<!-- Notice card: faint gold fill + gold hairline, rounded — for inline
     warnings/notices on the cream or navy page (both themes). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/gold_accent_faint" />
    <stroke
        android:width="1dp"
        android:color="@color/gold_accent" />
    <corners android:radius="12dp" />
</shape>
