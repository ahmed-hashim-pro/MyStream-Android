<?xml version="1.0" encoding="utf-8"?>
<!-- Header avatar (A .bn-avatar): gold gradient disc with a light-gold ring,
     shown behind the user's initials when no photo is set. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:startColor="@color/colorAccent"
        android:endColor="@color/gold_accent" />
    <stroke
        android:width="2dp"
        android:color="#B3D4A44C" />
</shape>
