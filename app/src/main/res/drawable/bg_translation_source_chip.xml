<?xml version="1.0" encoding="utf-8"?>
<!-- Translation-source chip in the reader text-mode strip: gold outline pill
     (mockup .chip.outline — transparent fill, gold-semi border). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/gold_accent_semi" />
    <corners android:radius="18dp" />
</shape>
