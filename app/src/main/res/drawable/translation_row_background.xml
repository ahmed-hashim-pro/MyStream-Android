<?xml version="1.0" encoding="utf-8"?>
<!-- Selected/active translation gets a faint gold wash; pressed flashes gold.
     Concrete colors only (no theme attrs / holo-dark) so it works in light & dark. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:drawable="@color/gold_accent_faint" />
    <item android:state_pressed="true" android:drawable="@color/gold_accent_faint" />
    <item android:drawable="@android:color/transparent" />
</selector>
