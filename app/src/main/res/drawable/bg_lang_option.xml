<?xml version="1.0" encoding="utf-8"?>
<!-- Language option row: gold ripple, rounded; selected state via a gold-faint fill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gold_accent_faint">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gold_accent_faint" />
                    <stroke android:width="1dp" android:color="@color/gold_accent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
