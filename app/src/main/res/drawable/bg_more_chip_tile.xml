<?xml version="1.0" encoding="utf-8"?>
<!-- Tile chip: outlined rather than filled so a 4-across grid does not read as a
     wall of gold. Both colours are theme attrs and follow day/night automatically. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/more_chip_corner_tile" />
    <solid android:color="?attr/colorSurface" />
    <stroke android:width="@dimen/more_hairline" android:color="?attr/colorOutlineVariant" />
</shape>
