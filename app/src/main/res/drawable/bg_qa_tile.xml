<?xml version="1.0" encoding="utf-8"?>
<!-- Warm-surface background for Quick Action tiles with gold-faint ripple press state. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gold_accent_faint">
    <!-- Mask: same shape as the normal background so ripple clips correctly -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Normal background: warm surface, 14dp rounded, subtle elevation via a hairline border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_light_surface" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
