<?xml version="1.0" encoding="utf-8"?>
<!-- Mushaf index hero: same radial navy gradient as bg_header_navy, but with
     rounded bottom corners so the whole header reads as one card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.8"
        android:centerY="0.0"
        android:gradientRadius="440dp"
        android:startColor="@color/navy_500"
        android:centerColor="@color/navy_700"
        android:endColor="@color/navy_900" />
    <corners
        android:bottomLeftRadius="@dimen/mushaf_hero_corner_radius"
        android:bottomRightRadius="@dimen/mushaf_hero_corner_radius" />
</shape>
