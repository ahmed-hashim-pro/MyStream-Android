<?xml version="1.0" encoding="utf-8"?>
<!-- Mushaf hero search lens — replicates the 🔍 emoji used in the re-theme
     mockup (hero.html): a silver-rimmed magnifier with a filled light glass and
     a dark handle. Multi-color on purpose; QuranActivity must NOT tint it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Dark handle (drawn first so the rim overlaps where they meet) -->
    <path
        android:strokeColor="#2E323D"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M14.4,14.4 L19.8,19.8" />

    <!-- Filled light glass -->
    <path
        android:fillColor="#E7EAF1"
        android:pathData="M4.2,9.8 a5.6,5.6 0 1,0 11.2,0 a5.6,5.6 0 1,0 -11.2,0 z" />

    <!-- Glassy highlight (top-left) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.75"
        android:pathData="M6.4,7.7 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 z" />

    <!-- Silver metallic rim -->
    <path
        android:strokeColor="#A7ADB8"
        android:strokeWidth="2"
        android:pathData="M3.8,9.8 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 z" />
</vector>
